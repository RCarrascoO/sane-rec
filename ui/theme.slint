// Material Design 3 (M3 Expressive) Theme Tokens for sane-rec

export global M3Theme {
    // -------------------------------------------------------------------------
    // M3 Dark Color Palette
    // -------------------------------------------------------------------------
    out property <color> surface: #141218;
    out property <color> surface-container: #211f26;
    out property <color> surface-container-high: #2b2930;
    out property <color> surface-container-highest: #36343b;

    out property <color> on-surface: #e6e0e9;
    out property <color> on-surface-variant: #cac4d0;
    out property <color> outline: #938f99;
    out property <color> outline-variant: #49454f;

    // Primary
    out property <color> primary: #d0bcff;
    out property <color> on-primary: #381e72;
    out property <color> primary-container: #4f378b;
    out property <color> on-primary-container: #eaddff;

    // Secondary
    out property <color> secondary: #ccc2dc;
    out property <color> on-secondary: #332d41;
    out property <color> secondary-container: #4a4458;
    out property <color> on-secondary-container: #e8def8;

    // Functional status
    out property <color> error: #f2b8b5;
    out property <color> on-error: #601410;
    out property <color> error-container: #8c1d18;
    out property <color> on-error-container: #f9dedc;

    out property <color> success: #a6d388;
    out property <color> on-success: #133800;
    out property <color> success-container: #295111;
    out property <color> on-success-container: #c2ef9f;

    // -------------------------------------------------------------------------
    // M3 Corner Radii
    // -------------------------------------------------------------------------
    out property <length> corner-small: 8px;
    out property <length> corner-medium: 12px;
    out property <length> corner-large: 16px;
    out property <length> corner-full: 9999px;

    // -------------------------------------------------------------------------
    // Spacing Scale
    // -------------------------------------------------------------------------
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 20px;
    out property <length> space-xxl: 24px;
    out property <length> space-xxxl: 32px;

    // -------------------------------------------------------------------------
    // Typography Scale
    // -------------------------------------------------------------------------
    out property <string> font-family: "Inter, Roboto, sans-serif";

    out property <length> font-headline: 24px;
    out property <length> font-title-large: 20px;
    out property <length> font-title-medium: 16px;
    out property <length> font-title-small: 14px;
    out property <length> font-body-large: 15px;
    out property <length> font-body-medium: 13px;
    out property <length> font-body-small: 12px;
    out property <length> font-label-large: 14px;
    out property <length> font-label-medium: 12px;
    out property <length> font-label-small: 10px;
}
