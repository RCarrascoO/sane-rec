// sane-rec: Material Design 3 (Google Pixel UI - Android 15/16 Material You Expressive)
// Main Window with Navigation Rail and Tonal Elevation (Zero Outer Borders)
import { Theme, M3Theme } from "theme.slint";
import {
    M3Icon,
    M3Card,
    M3Button,
    M3FilledButton,
    M3TonalButton,
    M3OutlinedButton,
    M3Switch,
    M3StatusChip,
    M3ProfileTile,
    M3RadioCard,
    M3SegmentItem,
    M3PresetChip,
    M3Chip,
    M3NavItem,
    M3NavigationRail,
    M3MetricTile,
    M3OptionItem,
    M3DropdownCard,
    M3ClipCard,
    M3VuMeter,
    M3Slider,
    M3Toast,
    M3InputField
} from "components.slint";
import { ScrollView } from "std-widgets.slint";

export struct ClipEntry {
    filename: string,
    file-size: string,
    date-text: string,
    duration-text: string,
    filepath: string,
    is-discord: bool,
}

export struct OutputEntry {
    name: string,
    description: string,
    badge: string,
    resolution: string,
}

export struct WindowEntry {
    id: int,
    title: string,
    app-id: string,
    badge: string,
}

export struct AudioDeviceEntry {
    name: string,
    description: string,
    badge: string,
    is-default: bool,
}

export component AppWindow inherits Window {
    title: "sane-rec — Instant Replay & Screen Recorder";
    icon: @image-url("../assets/sane-rec.png");
    min-width: 480px;
    preferred-width: 1020px;
    min-height: 540px;
    preferred-height: 740px;
    background: Theme.surface;
    default-font-family: Theme.font-family;

    // -------------------------------------------------------------------------
    // Callbacks públicos para integración con Rust
    // -------------------------------------------------------------------------
    callback save-clip();
    callback toggle-replay();
    callback toggle-recording();
    callback select-output-dir();
    callback select-profile(string);
    callback play-clip(string);
    callback open-clip-folder(string);
    callback open-output-folder();
    callback refresh-windows();
    callback select-area-slurp();
    callback refresh-gallery();
    callback select-screen(string, string);
    callback select-window(string, string);
    callback select-audio-sink(string);
    callback select-audio-mic(string);
    callback select-replay-duration(int);
    callback update-shortcuts(string, string);
    callback set-custom-codec(string);
    callback set-custom-preset(string);
    callback set-custom-crf(int);
    callback set-custom-max-ram(int);
    callback set-volume-system(float);
    callback set-volume-mic(float);
    callback toggle-audio-system(bool);
    callback toggle-audio-mic(bool);
    callback save-hardware-profile(string);
    callback load-hardware-profile(string);
    callback export-hardware-profile(string);
    callback import-hardware-profile();
    callback refresh-hardware-profiles();
    callback trigger-update();
    callback toggle-dual-clip(bool);
    callback set-discord-target-mb(int);
    callback compress-clip-for-discord(string);

    // -------------------------------------------------------------------------
    // Propiedades públicas para bindings con Rust
    // -------------------------------------------------------------------------
    in-out property <int> active-view: 0; // 0: Panel, 1: Fuentes, 2: Audio, 3: Ajustes, 4: Galería

    in-out property <string> active-profile: "sane-safe";
    in-out property <bool> is-running: false;
    in-out property <bool> is-recording: false;
    in-out property <string> recording-time: "00:00";
    in-out property <string> buffer-status: "Detenido";
    in-out property <string> output-path: "/mnt/Files/Videos/Replays";
    in-out property <int> replay-duration: 30;
    in-out property <string> selected-format: "mp4";
    in-out property <bool> dual-clip: false;
    in-out property <int> discord-target-mb: 10;

    // Auto-actualizador
    in-out property <bool> has-update: false;
    in-out property <string> update-version: "";
    in-out property <bool> is-updating: false;

    // Gestor de perfiles de hardware
    in-out property <[string]> available-profiles-list: ["Sane-Desktop-Polaris", "Notebook-Universal-Safe"];
    in-out property <string> selected-profile-name: "Sane-Desktop-Polaris";

    // Atajos de teclado y límites
    in-out property <string> shortcut-save: "Mod+F10";
    in-out property <string> shortcut-record: "Mod+F9";
    in-out property <string> custom-save-text: "Mod+F10";
    in-out property <string> custom-record-text: "Mod+F9";
    in-out property <int> max-memory-mb: 150;

    // Configuración interactiva del Perfil Personalizado
    in-out property <string> custom-codec: "libx264";
    in-out property <string> custom-preset: "ultrafast";
    in-out property <int> custom-crf: 23;

    // Video y captura
    in-out property <string> selected-screen: "DVI-D-1";
    in-out property <int> capture-mode: 0; // 0: Monitor, 1: Ventana, 2: Área (slurp)
    in-out property <int> selected-fps: 60;
    in-out property <string> selected-resolution: "1360x768";
    in-out property <string> selected-window: "Zen Browser";

    // Audio
    in-out property <bool> audio-system: true;
    in-out property <bool> audio-mic: false;
    in-out property <string> audio-sink: "PipeWire Default Sink";
    in-out property <string> audio-mic-source: "USB PnP Audio Device";
    in-out property <int> audio-track-mode: 0; // 0: Pista única combinada, 1: Pistas separadas
    in-out property <float> volume-system: 1.0;
    in-out property <float> volume-mic: 0.85;
    in-out property <float> system-volume-peak: 0.0;
    in-out property <float> mic-volume-peak: 0.0;

    // Métricas y estado
    in-out property <string> ram-usage: "~28 MB";
    in-out property <string> last-saved-clip: "";

    // Notificaciones Toast flotantes en la app
    in-out property <string> toast-message: "";
    in-out property <string> toast-icon: "info";
    in-out property <bool> toast-visible: false;

    // Estado desplegable interno para dropdowns
    property <bool> sink-dropdown-open: false;
    property <bool> mic-dropdown-open: false;

    // Lista de clips para la galería y clips recientes en el dashboard
    in-out property <[ClipEntry]> recent-clips: [];
    in-out property <[ClipEntry]> gallery-clips: [];

    // Modelos dinámicos descubiertos en Wayland / PipeWire
    in-out property <[OutputEntry]> available-screens: [
        { name: "DVI-D-1", description: "DVI-D-1 [1360x768 @ 60Hz]", badge: "Principal", resolution: "1360x768" },
        { name: "HDMI-A-1", description: "HDMI-A-1 [1366x768 @ 60Hz]", badge: "Secundario", resolution: "1366x768" }
    ];

    in-out property <[WindowEntry]> available-windows: [
        { id: 1, title: "Zen Browser — Navegador web", app-id: "zen", badge: "Ventana" },
        { id: 2, title: "Discord — Canal de voz", app-id: "discord", badge: "Ventana" },
        { id: 3, title: "Counter-Strike 2 — Videojuego", app-id: "cs2", badge: "Juego Fullscreen" },
        { id: 4, title: "Alacritty — Terminal Wayland", app-id: "alacritty", badge: "Ventana" }
    ];

    in-out property <[AudioDeviceEntry]> available-sinks: [
        { name: "PipeWire Default Sink", description: "PipeWire Default Sink (Salida analógica estéreo)", badge: "Por defecto", is-default: true },
        { name: "HDMI / DisplayPort", description: "Salida digital HDMI / DisplayPort", badge: "Digital", is-default: false }
    ];

    in-out property <[AudioDeviceEntry]> available-mics: [
        { name: "USB PnP Audio Device", description: "USB PnP Audio Device (Micrófono USB)", badge: "Conectado", is-default: true },
        { name: "Webcam C920", description: "Webcam C920 Stereo Microphone", badge: "Webcam", is-default: false },
        { name: "Front Mic", description: "Entrada analógica frontal (Front Mic)", badge: "Jack 3.5mm", is-default: false },
        { name: "Desactivado", description: "Desactivado (Solo audio de juego)", badge: "Mudo", is-default: false }
    ];

    // =========================================================================
    // 1. Navigation Rail Lateral Izquierdo (M3 Expressive)
    // Sin línea divisoria con el contenido, descansando en Theme.surface
    // =========================================================================
    rail := M3NavigationRail {
        x: 0px;
        y: 0px;
        height: parent.height;
        active-view <=> root.active-view;
        compact: root.width < 820px;
    }

    // =========================================================================
    // 2. Contenedor Dinámico Principal (Vistas 0 a 4)
    // =========================================================================
    Rectangle {
        x: rail.width;
        y: 0px;
        width: parent.width - rail.width;
        height: parent.height;
        background: Theme.surface;
        border-width: 0px;
        clip: true;

        ScrollView {
            width: 100%;
            height: 100%;
            content-width: self.width;

            HorizontalLayout {
                alignment: center;
                padding-left: root.width < 820px ? 12px : 24px;
                padding-right: root.width < 820px ? 12px : 24px;
                padding-top: root.height < 800px ? 14px : 20px;
                padding-bottom: 24px;

                VerticalLayout {
                    width: Math.min(root.width - rail.width - (root.width < 820px ? 24px : 48px), 1020px);
                    spacing: root.height < 800px ? 16px : 20px;

                    // Banner flotante de auto-actualización disponible (Tonal, cero bordes)
                    if root.has-update: Rectangle {
                        height: 48px;
                        border-radius: Theme.radius-md;
                        background: Theme.primary-container;
                        border-width: 0px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 10px;
                                M3Icon {
                                    name: "rocket";
                                    icon-size: 18px;
                                    icon-color: Theme.on-primary-container;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Nueva versión disponible: " + root.update-version;
                                    font-size: Theme.font-body-medium;
                                    font-weight: 700;
                                    color: Theme.on-primary-container;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                M3Button {
                                    text: root.is-updating ? "Actualizando..." : "Actualizar ahora";
                                    variant: "filled";
                                    btn-height: 32px;
                                    btn-padding-h: 14px;
                                    enabled: !root.is-updating;
                                    clicked => { root.trigger-update(); }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // VISTA 0: DASHBOARD (Panel de control)
                    // ---------------------------------------------------------
                    if root.active-view == 0: VerticalLayout {
                        spacing: 20px;

                        // Header Dashboard (Sentence case)
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Panel de control";
                                    font-size: 28px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Monitor en vivo del búfer de repetición y estado del sistema";
                                    font-size: 13px;
                                    color: Theme.on-surface-variant;
                                }
                            }

                            M3StatusChip {
                                y: (parent.height - self.height) / 2;
                                text: root.is-recording ? ("REC " + root.recording-time) :
                                      root.is-running ? (root.buffer-status == "Detenido" ? "Búfer Activo" : root.buffer-status) :
                                      "Detenido";
                                status: root.is-recording ? "recording" :
                                        root.is-running ? "active" : "idle";
                            }
                        }

                        // Hero Card: Estado en vivo del Replay en RAM (Tonal Elevation, Cero bordes)
                        M3Card {
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 18px;

                                // Fila superior: Indicadores de búfer y memoria
                                HorizontalLayout {
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: start;

                                        // Icono circular tonal
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: 24px;
                                            background: root.is-running ?
                                                Theme.primary.with-alpha(0.2) :
                                                Theme.surface-container-highest;
                                            border-width: 0px;
                                            y: (parent.height - self.height) / 2;

                                            M3Icon {
                                                name: "memory";
                                                icon-size: 24px;
                                                icon-color: root.is-running ? Theme.primary : Theme.on-surface-variant;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;

                                            Text {
                                                text: "Búfer de repetición en memoria RAM";
                                                font-size: Theme.font-label-medium;
                                                font-weight: 600;
                                                color: Theme.on-surface-variant;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                Text {
                                                    text: root.is-running ?
                                                        (root.replay-duration + "s / " + root.replay-duration + "s") :
                                                        ("0s / " + root.replay-duration + "s");
                                                    font-size: 24px;
                                                    font-weight: 700;
                                                    color: root.is-running ? Theme.primary : Theme.on-surface;
                                                }

                                                Rectangle {
                                                    height: 22px;
                                                    border-radius: Theme.radius-full;
                                                    border-width: 0px;
                                                    background: root.is-running ?
                                                        Theme.secondary-container :
                                                        Theme.surface-container-highest;
                                                    y: (parent.height - self.height) / 2;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        Text {
                                                            text: root.is-running ? (root.ram-usage + " / " + root.max-memory-mb + " MB") : (root.max-memory-mb + " MB máx");
                                                            font-size: Theme.font-label-small;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                            color: root.is-running ?
                                                                Theme.on-secondary-container :
                                                                Theme.on-surface-variant;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Switch de activación del daemon
                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: end;

                                        Text {
                                            text: "Daemon replay";
                                            font-size: Theme.font-label-large;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            color: root.is-running ? Theme.primary : Theme.on-surface-variant;
                                        }

                                        M3Switch {
                                            y: (parent.height - self.height) / 2;
                                            checked: root.is-running;
                                            toggled(state) => {
                                                root.is-running = state;
                                                root.toggle-replay();
                                            }
                                        }
                                    }
                                }

                                // Barra de progreso visual del búfer (radius-full)
                                Rectangle {
                                    height: 8px;
                                    border-radius: Theme.radius-full;
                                    background: Theme.surface-container-highest;
                                    border-width: 0px;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: parent.height;
                                        width: root.is-running ? parent.width : 0px;
                                        border-radius: Theme.radius-full;
                                        background: Theme.primary;

                                        animate width { duration: 400ms; easing: ease-out; }
                                    }
                                }

                                // Botones grandes de acción rápida responsivos (sin emojis)
                                if root.width >= 720px: HorizontalLayout {
                                    spacing: 14px;

                                    M3Button {
                                        horizontal-stretch: 1;
                                        text: "Guardar replay (" + root.shortcut-save + ")";
                                        icon-name: "save";
                                        variant: "filled";
                                        btn-height: 48px;
                                        enabled: root.is-running;
                                        clicked => {
                                            root.save-clip();
                                        }
                                    }

                                    M3Button {
                                        horizontal-stretch: 1;
                                        text: root.is-recording ? ("Detener REC " + root.recording-time + " (" + root.shortcut-record + ")") : ("Grabación continua (" + root.shortcut-record + ")");
                                        icon-name: root.is-recording ? "stop" : "record";
                                        variant: root.is-recording ? "filled" : "tonal";
                                        btn-height: 48px;
                                        clicked => {
                                            root.is-recording = !root.is-recording;
                                            root.toggle-recording();
                                        }
                                    }
                                }

                                if root.width < 720px: VerticalLayout {
                                    spacing: 10px;

                                    M3Button {
                                        text: "Guardar replay (" + root.shortcut-save + ")";
                                        icon-name: "save";
                                        variant: "filled";
                                        btn-height: 44px;
                                        enabled: root.is-running;
                                        clicked => {
                                            root.save-clip();
                                        }
                                    }

                                    M3Button {
                                        text: root.is-recording ? ("Detener REC " + root.recording-time + " (" + root.shortcut-record + ")") : ("Grabación continua (" + root.shortcut-record + ")");
                                        icon-name: root.is-recording ? "stop" : "record";
                                        variant: root.is-recording ? "filled" : "tonal";
                                        btn-height: 44px;
                                        clicked => {
                                            root.is-recording = !root.is-recording;
                                            root.toggle-recording();
                                        }
                                    }
                                }
                            }
                        }

                        // Métricas del Sistema: Cero Bordes y Tonal Elevation
                        if root.width >= 820px: HorizontalLayout {
                            spacing: 12px;
                            height: 104px;

                            M3MetricTile {
                                horizontal-stretch: 1;
                                icon-name: "bolt";
                                value: root.selected-fps + " FPS";
                                label: "Tasa de refresco";
                                badge-text: "Fluido";
                                highlight: true;
                            }

                            M3MetricTile {
                                horizontal-stretch: 1;
                                icon-name: "desktop";
                                value: root.selected-resolution;
                                label: "Resolución activa";
                                badge-text: root.selected-screen;
                            }

                            M3MetricTile {
                                horizontal-stretch: 1;
                                icon-name: "record";
                                value: root.replay-duration + "s";
                                label: "Búfer en RAM";
                                badge-text: "Instantáneo";
                            }

                            M3MetricTile {
                                horizontal-stretch: 1;
                                icon-name: "memory";
                                value: root.ram-usage;
                                label: "Consumo RAM (máx: " + root.max-memory-mb + " MB)";
                                badge-text: "dmabuf";
                            }
                        }

                        if root.width < 820px: VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                height: 104px;

                                M3MetricTile {
                                    horizontal-stretch: 1;
                                    icon-name: "bolt";
                                    value: root.selected-fps + " FPS";
                                    label: "Tasa de refresco";
                                    badge-text: "Fluido";
                                    highlight: true;
                                }

                                M3MetricTile {
                                    horizontal-stretch: 1;
                                    icon-name: "desktop";
                                    value: root.selected-resolution;
                                    label: "Resolución activa";
                                    badge-text: root.selected-screen;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                height: 104px;

                                M3MetricTile {
                                    horizontal-stretch: 1;
                                    icon-name: "record";
                                    value: root.replay-duration + "s";
                                    label: "Búfer en RAM";
                                    badge-text: "Instantáneo";
                                }

                                M3MetricTile {
                                    horizontal-stretch: 1;
                                    icon-name: "memory";
                                    value: root.ram-usage;
                                    label: "Consumo RAM (máx: " + root.max-memory-mb + " MB)";
                                    badge-text: "dmabuf";
                                }
                            }
                        }

                        // Tarjeta con detalles de la Fuente Activa (Cero bordes)
                        M3Card {
                            content-padding: 16px;
                            card-background: Theme.surface-container;
                            card-radius: Theme.radius-lg;
                            card-border-width: 0px;

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;

                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: Theme.surface-container-high;
                                        border-width: 0px;
                                        y: (parent.height - self.height) / 2;

                                        M3Icon {
                                            name: "desktop";
                                            icon-size: 20px;
                                            icon-color: Theme.primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Fuente activa: " + root.selected-screen + " • " + root.selected-fps + " FPS • " + (root.active-profile == "sane-safe" ? "Sane Safe (CPU)" : "Hardware VA-API");
                                            font-size: Theme.font-title-small;
                                            font-weight: 700;
                                            color: Theme.on-surface;
                                        }

                                        Text {
                                            text: "Captura directa Wayland vía dmabuf/PipeWire sin sobrecarga de GPU Polaris.";
                                            font-size: Theme.font-body-small;
                                            color: Theme.on-surface-variant;
                                        }
                                    }
                                }

                                M3Button {
                                    text: "Cambiar fuente";
                                    variant: "outlined";
                                    btn-height: 36px;
                                    btn-padding-h: 16px;
                                    clicked => {
                                        root.active-view = 1;
                                    }
                                }
                            }
                        }

                        // Sección de Clips Recientes en el Dashboard (Sentence case, cero bordes)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Clips recientes (" + root.gallery-clips.length + ")";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: Theme.primary;
                                        vertical-alignment: center;
                                    }

                                    if root.gallery-clips.length > 0: M3Button {
                                        text: "Ver todos en galería";
                                        icon-name: "folder";
                                        variant: "tonal";
                                        btn-height: 34px;
                                        btn-padding-h: 14px;
                                        clicked => {
                                            root.active-view = 4;
                                        }
                                    }
                                }

                                if root.gallery-clips.length == 0: HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;

                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: Theme.surface-container-high;
                                        border-width: 0px;
                                        y: (parent.height - self.height) / 2;

                                        M3Icon {
                                            name: "folder";
                                            icon-size: 20px;
                                            icon-color: Theme.on-surface-variant;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Sin clips guardados en esta sesión";
                                            font-size: Theme.font-title-small;
                                            font-weight: 700;
                                            color: Theme.on-surface-variant;
                                        }

                                        Text {
                                            text: "Presiona " + root.shortcut-save + " o el botón superior para capturar los últimos " + root.replay-duration + " segundos.";
                                            font-size: Theme.font-body-small;
                                            color: Theme.on-surface-variant;
                                        }
                                    }
                                }

                                for clip in root.recent-clips: M3ClipCard {
                                    filename: clip.filename;
                                    file-size: clip.file-size;
                                    date-text: clip.date-text;
                                    duration-text: clip.duration-text;
                                    filepath: clip.filepath;
                                    is-discord: clip.is-discord;

                                    play-clicked(path) => {
                                        root.play-clip(path);
                                    }

                                    folder-clicked(path) => {
                                        root.open-clip-folder(path);
                                    }

                                    compress-clicked(path) => {
                                        root.compress-clip-for-discord(path);
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // VISTA 1: FUENTES DE VIDEO (Sentence case)
                    // ---------------------------------------------------------
                    if root.active-view == 1: VerticalLayout {
                        spacing: 20px;

                        // Header Fuentes
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Fuentes de video";
                                font-size: 28px;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: "Selecciona el origen de captura para el búfer y grabaciones";
                                font-size: 13px;
                                color: Theme.on-surface-variant;
                            }
                        }

                        // Selector de Modo de Captura (Segmented Buttons M3, Cero Bordes)
                        M3Card {
                            content-padding: 16px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 12px;

                                Text {
                                    text: "Tipo de captura";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                Rectangle {
                                    height: 44px;
                                    border-radius: Theme.radius-full;
                                    background: Theme.surface-container-high;
                                    border-width: 0px;

                                    HorizontalLayout {
                                        padding: 4px;
                                        spacing: 4px;

                                        M3SegmentItem {
                                            horizontal-stretch: 1;
                                            icon-name: "desktop";
                                            text: "Monitor completo";
                                            is-selected: root.capture-mode == 0;
                                            clicked => { root.capture-mode = 0; }
                                        }

                                        M3SegmentItem {
                                            horizontal-stretch: 1;
                                            icon-name: "window";
                                            text: "Ventana / juego";
                                            is-selected: root.capture-mode == 1;
                                            clicked => { root.capture-mode = 1; }
                                        }

                                        M3SegmentItem {
                                            horizontal-stretch: 1;
                                            icon-name: "slurp";
                                            text: "Área (slurp)";
                                            is-selected: root.capture-mode == 2;
                                            clicked => { root.capture-mode = 2; }
                                        }
                                    }
                                }
                            }
                        }

                        // Detalle según el tipo de captura
                        if root.capture-mode == 0: VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "Monitores detectados (Wayland)";
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.primary;
                            }

                            for item in root.available-screens: M3OptionItem {
                                text: item.description;
                                badge-text: item.badge;
                                is-selected: root.selected-screen == item.name;
                                clicked => {
                                    root.selected-screen = item.name;
                                    root.selected-resolution = item.resolution;
                                    root.select-screen(item.name, item.resolution);
                                }
                            }
                        }

                        if root.capture-mode == 1: VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Ventanas activas detectadas";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                M3Button {
                                    text: "Refrescar";
                                    icon-name: "refresh";
                                    variant: "tonal";
                                    btn-height: 34px;
                                    btn-padding-h: 14px;
                                    clicked => {
                                        root.refresh-windows();
                                    }
                                }
                            }

                            for item in root.available-windows: M3OptionItem {
                                text: item.title;
                                badge-text: item.badge;
                                is-selected: root.selected-window == item.title;
                                clicked => {
                                    root.selected-window = item.title;
                                    root.selected-screen = "window:" + item.app-id;
                                    root.select-window(item.title, item.app-id);
                                }
                            }
                        }

                        if root.capture-mode == 2: M3Card {
                            content-padding: 24px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: 28px;
                                    background: Theme.primary-container;
                                    border-width: 0px;

                                    M3Icon {
                                        name: "slurp";
                                        icon-size: 26px;
                                        icon-color: Theme.on-primary-container;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                Text {
                                    text: "Selección interactiva con Slurp";
                                    font-size: Theme.font-title-medium;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Haz clic en el botón para activar la herramienta slurp en Wayland. Podrás trazar un rectángulo en pantalla con el ratón o hacer clic sobre una ventana para capturar solo esa región exacta.";
                                    font-size: Theme.font-body-small;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                M3Button {
                                    text: "Seleccionar ventana o área con slurp";
                                    icon-name: "slurp";
                                    variant: "filled";
                                    btn-height: 44px;
                                    btn-padding-h: 24px;
                                    clicked => {
                                        root.select-area-slurp();
                                    }
                                }
                            }
                        }

                        // Parámetros de FPS y Resolución (Cero bordes)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 18px;

                                Text {
                                    text: "Parámetros de video";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                // Tasa de FPS
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Tasa de refresco (FPS)";
                                        font-size: Theme.font-body-medium;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }

                                    Rectangle {
                                        height: 42px;
                                        border-radius: Theme.radius-full;
                                        background: Theme.surface-container-high;
                                        border-width: 0px;

                                        HorizontalLayout {
                                            padding: 4px;
                                            spacing: 4px;

                                            M3SegmentItem {
                                                horizontal-stretch: 1;
                                                text: "60 FPS (Fluidez recomendada)";
                                                is-selected: root.selected-fps == 60;
                                                clicked => { root.selected-fps = 60; }
                                            }

                                            M3SegmentItem {
                                                horizontal-stretch: 1;
                                                text: "30 FPS (Ahorro de CPU)";
                                                is-selected: root.selected-fps == 30;
                                                clicked => { root.selected-fps = 30; }
                                            }
                                        }
                                    }
                                }

                                // Resolución de Captura Ampliada
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        Text {
                                            text: "Resolución de captura";
                                            font-size: Theme.font-body-medium;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                        }

                                        Text {
                                            text: "Activa: " + root.selected-resolution;
                                            font-size: Theme.font-label-small;
                                            font-weight: 700;
                                            color: Theme.primary;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 8px;

                                        // Fila 1: Nativa y 1080p FHD
                                        Rectangle {
                                            height: 42px;
                                            border-radius: Theme.radius-full;
                                            background: Theme.surface-container-high;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding: 4px;
                                                spacing: 4px;

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "Nativa (100%)";
                                                    is-selected: root.selected-resolution == "Nativa (100%)" || root.selected-resolution == "1360x768" || root.selected-resolution == "1366x768" || root.selected-resolution == "none";
                                                    clicked => {
                                                        root.selected-resolution = "Nativa (100%)";
                                                        root.select-screen(root.selected-screen, "none");
                                                    }
                                                }

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "1080p (FHD - 1920x1080)";
                                                    is-selected: root.selected-resolution == "1920x1080";
                                                    clicked => {
                                                        root.selected-resolution = "1920x1080";
                                                        root.select-screen(root.selected-screen, "1920x1080");
                                                    }
                                                }
                                            }
                                        }

                                        // Fila 2: 720p HD y 1440p 2K
                                        Rectangle {
                                            height: 42px;
                                            border-radius: Theme.radius-full;
                                            background: Theme.surface-container-high;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding: 4px;
                                                spacing: 4px;

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "720p (HD - 1280x720)";
                                                    is-selected: root.selected-resolution == "1280x720";
                                                    clicked => {
                                                        root.selected-resolution = "1280x720";
                                                        root.select-screen(root.selected-screen, "1280x720");
                                                    }
                                                }

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "1440p (2K - 2560x1440)";
                                                    is-selected: root.selected-resolution == "2560x1440";
                                                    clicked => {
                                                        root.selected-resolution = "2560x1440";
                                                        root.select-screen(root.selected-screen, "2560x1440");
                                                    }
                                                }
                                            }
                                        }

                                        // Fila 3: 4K UHD y 540p SD
                                        Rectangle {
                                            height: 42px;
                                            border-radius: Theme.radius-full;
                                            background: Theme.surface-container-high;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding: 4px;
                                                spacing: 4px;

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "4K (UHD - 3840x2160)";
                                                    is-selected: root.selected-resolution == "3840x2160";
                                                    clicked => {
                                                        root.selected-resolution = "3840x2160";
                                                        root.select-screen(root.selected-screen, "3840x2160");
                                                    }
                                                }

                                                M3SegmentItem {
                                                    horizontal-stretch: 1;
                                                    text: "540p (SD - 960x540)";
                                                    is-selected: root.selected-resolution == "960x540";
                                                    clicked => {
                                                        root.selected-resolution = "960x540";
                                                        root.select-screen(root.selected-screen, "960x540");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // VISTA 2: MEZCLADOR DE AUDIO (Sentence case, sliders M3)
                    // ---------------------------------------------------------
                    if root.active-view == 2: VerticalLayout {
                        spacing: 20px;

                        // Header Audio
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Mezclador de audio";
                                font-size: 28px;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: "Configuración de canales de audio del sistema y micrófonos en PipeWire";
                                font-size: 13px;
                                color: Theme.on-surface-variant;
                            }
                        }

                        // Dispositivo de Audio del Sistema (Sink)
                        M3DropdownCard {
                            title: "Dispositivo de audio del sistema / juego";
                            description: "Captura el audio estéreo reproducido por tus juegos y aplicaciones";
                            icon-name: "speaker";
                            current-value: root.audio-sink;
                            is-open: root.sink-dropdown-open;
                            toggled => {
                                root.sink-dropdown-open = !root.sink-dropdown-open;
                            }

                            for item in root.available-sinks: M3OptionItem {
                                text: item.description;
                                badge-text: item.badge;
                                is-selected: root.audio-sink == item.name;
                                clicked => {
                                    root.audio-sink = item.name;
                                    root.sink-dropdown-open = false;
                                    root.select-audio-sink(item.name);
                                }
                            }
                        }

                        // Dispositivo de Micrófono (Source)
                        M3DropdownCard {
                            title: "Entrada de micrófono";
                            description: "Captura tu voz con cancelación de eco en tiempo real";
                            icon-name: "mic";
                            current-value: root.audio-mic-source;
                            is-open: root.mic-dropdown-open;
                            toggled => {
                                root.mic-dropdown-open = !root.mic-dropdown-open;
                            }

                            for item in root.available-mics: M3OptionItem {
                                text: item.description;
                                badge-text: item.badge;
                                is-selected: root.audio-mic-source == item.name;
                                clicked => {
                                    root.audio-mic-source = item.name;
                                    root.audio-mic = item.name != "Desactivado";
                                    root.mic-dropdown-open = false;
                                    root.select-audio-mic(item.name);
                                }
                            }
                        }

                        // Selector de Modo de Pistas de Audio (Cero bordes, tonal selection)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 14px;

                                Text {
                                    text: "Modo de pistas en el archivo";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    // Opción A: Pista combinada
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-lg;
                                        border-width: 0px;
                                        background: root.audio-track-mode == 0 ?
                                            Theme.secondary-container :
                                            Theme.surface-container-high;

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.audio-track-mode = 0; }

                                            VerticalLayout {
                                                padding: 16px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text {
                                                        text: "Pista única combinada";
                                                        font-size: Theme.font-title-small;
                                                        font-weight: 700;
                                                        color: root.audio-track-mode == 0 ?
                                                            Theme.on-secondary-container :
                                                            Theme.on-surface;
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: Theme.radius-full;
                                                        border-width: 0px;
                                                        background: root.audio-track-mode == 0 ? Theme.primary : Theme.surface-container-highest;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            Text {
                                                                text: "Discord";
                                                                font-size: 10px;
                                                                font-weight: 700;
                                                                color: root.audio-track-mode == 0 ? Theme.on-primary : Theme.on-surface-variant;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: "Juego y micrófono mezclados en un solo canal estéreo. Ideal para compartir directamente en Discord o redes sin configuración extra.";
                                                    font-size: Theme.font-body-small;
                                                    color: root.audio-track-mode == 0 ?
                                                        Theme.on-secondary-container.with-alpha(0.85) :
                                                        Theme.on-surface-variant;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }

                                    // Opción B: Pistas separadas
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-lg;
                                        border-width: 0px;
                                        background: root.audio-track-mode == 1 ?
                                            Theme.secondary-container :
                                            Theme.surface-container-high;

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.audio-track-mode = 1; }

                                            VerticalLayout {
                                                padding: 16px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text {
                                                        text: "Pistas separadas";
                                                        font-size: Theme.font-title-small;
                                                        font-weight: 700;
                                                        color: root.audio-track-mode == 1 ?
                                                            Theme.on-secondary-container :
                                                            Theme.on-surface;
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: Theme.radius-full;
                                                        border-width: 0px;
                                                        background: root.audio-track-mode == 1 ? Theme.primary : Theme.surface-container-highest;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            Text {
                                                                text: "Edición";
                                                                font-size: 10px;
                                                                font-weight: 700;
                                                                color: root.audio-track-mode == 1 ? Theme.on-primary : Theme.on-surface-variant;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: "Pista 1: Audio del juego • Pista 2: Micrófono independiente. Permite ajustar o silenciar tu voz luego en Kdenlive o DaVinci.";
                                                    font-size: Theme.font-body-small;
                                                    color: root.audio-track-mode == 1 ?
                                                        Theme.on-secondary-container.with-alpha(0.85) :
                                                        Theme.on-surface-variant;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Controles de Volumen y Silencio (M3Slider + M3VuMeter)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 20px;

                                Text {
                                    text: "Niveles de volumen y silencio";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                // Canal Sistema
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            M3Icon {
                                                name: "speaker";
                                                icon-size: 18px;
                                                icon-color: Theme.on-surface;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "Volumen del sistema / juego: " + Math.round(root.volume-system * 100) + "%";
                                                font-size: Theme.font-body-medium;
                                                font-weight: 600;
                                                color: Theme.on-surface;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.audio-system ? "Activo" : "Silenciado";
                                                font-size: Theme.font-label-small;
                                                color: root.audio-system ? Theme.primary : Theme.on-surface-variant;
                                                vertical-alignment: center;
                                            }
                                            M3Switch {
                                                y: (parent.height - self.height) / 2;
                                                checked: root.audio-system;
                                                toggled(state) => {
                                                    root.audio-system = state;
                                                    root.toggle-audio-system(state);
                                                }
                                            }
                                        }
                                    }

                                    M3Slider {
                                        minimum: 0.0;
                                        maximum: 1.5;
                                        value <=> root.volume-system;
                                        changed(val) => {
                                            root.set-volume-system(val);
                                        }
                                    }

                                    M3VuMeter {
                                        peak-level: root.system-volume-peak;
                                        active: root.audio-system;
                                        label: "Nivel";
                                    }
                                }

                                // Canal Micrófono
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            M3Icon {
                                                name: "mic";
                                                icon-size: 18px;
                                                icon-color: Theme.on-surface;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "Volumen del micrófono: " + Math.round(root.volume-mic * 100) + "%";
                                                font-size: Theme.font-body-medium;
                                                font-weight: 600;
                                                color: Theme.on-surface;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.audio-mic ? "Activo" : "Silenciado";
                                                font-size: Theme.font-label-small;
                                                color: root.audio-mic ? Theme.primary : Theme.on-surface-variant;
                                                vertical-alignment: center;
                                            }
                                            M3Switch {
                                                y: (parent.height - self.height) / 2;
                                                checked: root.audio-mic;
                                                toggled(state) => {
                                                    root.audio-mic = state;
                                                    root.toggle-audio-mic(state);
                                                }
                                            }
                                        }
                                    }

                                    M3Slider {
                                        minimum: 0.0;
                                        maximum: 1.5;
                                        value <=> root.volume-mic;
                                        changed(val) => {
                                            root.set-volume-mic(val);
                                        }
                                    }

                                    M3VuMeter {
                                        peak-level: root.mic-volume-peak;
                                        active: root.audio-mic && root.audio-mic-source != "Desactivado";
                                        label: "Nivel";
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // VISTA 3: AJUSTES Y PRESETS (Sentence case, Android Settings list items)
                    // ---------------------------------------------------------
                    if root.active-view == 3: VerticalLayout {
                        spacing: 20px;

                        // Header Ajustes
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Ajustes y presets";
                                font-size: 28px;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: "Perfiles de codificador, buffers y directorios de almacenamiento";
                                font-size: 13px;
                                color: Theme.on-surface-variant;
                            }
                        }

                        // Perfiles de Hardware (M3ProfileTile alineado como Android Settings)
                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "Perfil de codificación (estabilidad / hardware)";
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.primary;
                            }

                            // 1. Sane Safe (CPU x264)
                            M3ProfileTile {
                                title: "Sane Safe (CPU x264)";
                                subtitle: "Codificación por CPU sin riesgo de GPU freeze • Ideal Polaris / Linux";
                                badge-text: "Recomendado / Estable";
                                icon-name: "shield";
                                is-selected: root.active-profile == "sane-safe";
                                clicked => {
                                    root.active-profile = "sane-safe";
                                    root.select-profile("sane-safe");
                                }
                            }

                            // 2. AMD Hardware (VA-API)
                            M3ProfileTile {
                                title: "AMD Hardware (VA-API)";
                                subtitle: "Aceleración por GPU Radeon • Consumo ultra bajo de CPU";
                                badge-text: "Experimental";
                                warning-text: "Incompatible con AMD Polaris (RX 570)";
                                icon-name: "bolt";
                                is-selected: root.active-profile == "amd-vaapi";
                                clicked => {
                                    root.active-profile = "amd-vaapi";
                                    root.select-profile("amd-vaapi");
                                }
                            }

                            // 3. NVIDIA Hardware (NVENC)
                            M3ProfileTile {
                                title: "NVIDIA Hardware (NVENC)";
                                subtitle: "Aceleración por hardware NVIDIA en GPU GeForce";
                                badge-text: "Experimental";
                                icon-name: "bolt";
                                is-selected: root.active-profile == "nvidia-nvenc";
                                clicked => {
                                    root.active-profile = "nvidia-nvenc";
                                    root.select-profile("nvidia-nvenc");
                                }
                            }

                            // 4. Intel Hardware (QuickSync)
                            M3ProfileTile {
                                title: "Intel Hardware (QuickSync)";
                                subtitle: "Aceleración por GPU Intel QuickSync Video (iGPU / Arc)";
                                badge-text: "Experimental";
                                icon-name: "bolt";
                                is-selected: root.active-profile == "intel-qsv";
                                clicked => {
                                    root.active-profile = "intel-qsv";
                                    root.select-profile("intel-qsv");
                                }
                            }

                            // 5. Personalizado
                            M3ProfileTile {
                                title: "Personalizado";
                                subtitle: "Ajustes interactivos de códec, velocidad CPU, CRF y límite de RAM";
                                badge-text: "Avanzado";
                                icon-name: "tune";
                                is-selected: root.active-profile == "custom";
                                clicked => {
                                    root.active-profile = "custom";
                                    root.select-profile("custom");
                                }
                            }
                        }

                        // Parámetros interactivos del Modo Personalizado (Cero bordes)
                        if root.active-profile == "custom": M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "Parámetros del perfil personalizado";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                Text {
                                    text: "Configura el codificador, compresión y límites de memoria en vivo sin editar archivos.";
                                    font-size: Theme.font-body-small;
                                    color: Theme.on-surface-variant;
                                }

                                // 1. Códec de Video
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Códec de video:";
                                        font-size: Theme.font-label-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "libx264 (H.264)";
                                            is-active: root.custom-codec == "libx264";
                                            clicked => {
                                                root.custom-codec = "libx264";
                                                root.set-custom-codec("libx264");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "libx265 (HEVC)";
                                            is-active: root.custom-codec == "libx265";
                                            clicked => {
                                                root.custom-codec = "libx265";
                                                root.set-custom-codec("libx265");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "libvpx-vp9";
                                            is-active: root.custom-codec == "libvpx-vp9";
                                            clicked => {
                                                root.custom-codec = "libvpx-vp9";
                                                root.set-custom-codec("libvpx-vp9");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "h264_vaapi";
                                            is-active: root.custom-codec == "h264_vaapi";
                                            clicked => {
                                                root.custom-codec = "h264_vaapi";
                                                root.set-custom-codec("h264_vaapi");
                                            }
                                        }
                                    }
                                }

                                // 2. Preset CPU (Velocidad vs CPU)
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Preset de velocidad CPU:";
                                        font-size: Theme.font-label-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "ultrafast";
                                            is-active: root.custom-preset == "ultrafast";
                                            clicked => {
                                                root.custom-preset = "ultrafast";
                                                root.set-custom-preset("ultrafast");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "superfast";
                                            is-active: root.custom-preset == "superfast";
                                            clicked => {
                                                root.custom-preset = "superfast";
                                                root.set-custom-preset("superfast");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "veryfast";
                                            is-active: root.custom-preset == "veryfast";
                                            clicked => {
                                                root.custom-preset = "veryfast";
                                                root.set-custom-preset("veryfast");
                                            }
                                        }
                                        M3PresetChip {
                                            text: "fast";
                                            is-active: root.custom-preset == "fast";
                                            clicked => {
                                                root.custom-preset = "fast";
                                                root.set-custom-preset("fast");
                                            }
                                        }
                                    }
                                }

                                // 3. Calidad CRF
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Calidad CRF (" + root.custom-crf + " - menor es mayor calidad):";
                                        font-size: Theme.font-label-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "18 (Ultra)";
                                            is-active: root.custom-crf <= 18;
                                            clicked => {
                                                root.custom-crf = 18;
                                                root.set-custom-crf(18);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "21 (Alta)";
                                            is-active: root.custom-crf > 18 && root.custom-crf <= 21;
                                            clicked => {
                                                root.custom-crf = 21;
                                                root.set-custom-crf(21);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "23 (Equilibrada)";
                                            is-active: root.custom-crf > 21 && root.custom-crf <= 25;
                                            clicked => {
                                                root.custom-crf = 23;
                                                root.set-custom-crf(23);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "28 (Bajo peso)";
                                            is-active: root.custom-crf > 25;
                                            clicked => {
                                                root.custom-crf = 28;
                                                root.set-custom-crf(28);
                                            }
                                        }
                                    }
                                }

                                // 4. Límite de Búfer RAM
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Límite máximo de búfer RAM (" + root.max-memory-mb + " MB):";
                                        font-size: Theme.font-label-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "100 MB";
                                            is-active: root.max-memory-mb <= 120;
                                            clicked => {
                                                root.max-memory-mb = 100;
                                                root.set-custom-max-ram(100);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "150 MB (Recomendado)";
                                            is-active: root.max-memory-mb > 120 && root.max-memory-mb <= 200;
                                            clicked => {
                                                root.max-memory-mb = 150;
                                                root.set-custom-max-ram(150);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "250 MB";
                                            is-active: root.max-memory-mb > 200 && root.max-memory-mb <= 350;
                                            clicked => {
                                                root.max-memory-mb = 250;
                                                root.set-custom-max-ram(250);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "500 MB";
                                            is-active: root.max-memory-mb > 350 && root.max-memory-mb <= 750;
                                            clicked => {
                                                root.max-memory-mb = 500;
                                                root.set-custom-max-ram(500);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "1 GB (Gamer)";
                                            is-active: root.max-memory-mb > 750;
                                            clicked => {
                                                root.max-memory-mb = 1024;
                                                root.set-custom-max-ram(1024);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Gestor de Perfiles de Hardware de Equipos
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Gestor de perfiles de equipo";
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Theme.primary;
                                        }
                                        Text {
                                            text: "Guarda, exporta y carga perfiles optimizados para PCs o laptops específicos (~/.config/sane-rec/profiles/).";
                                            font-size: Theme.font-body-small;
                                            color: Theme.on-surface-variant;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3Button {
                                            text: "Importar (.toml)";
                                            variant: "tonal";
                                            btn-height: 34px;
                                            btn-padding-h: 14px;
                                            clicked => { root.import-hardware-profile(); }
                                        }
                                        M3Button {
                                            text: "Guardar actual";
                                            variant: "tonal";
                                            btn-height: 34px;
                                            btn-padding-h: 14px;
                                            clicked => { root.save-hardware-profile(root.selected-profile-name); }
                                        }
                                    }
                                }

                                // Selector de perfiles disponibles
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Perfiles guardados en el sistema:";
                                        font-size: Theme.font-label-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        for p-name in root.available-profiles-list: M3PresetChip {
                                            text: p-name;
                                            is-active: root.selected-profile-name == p-name;
                                            clicked => {
                                                root.selected-profile-name = p-name;
                                                root.load-hardware-profile(p-name);
                                            }
                                        }
                                    }
                                }

                                // Acciones sobre el perfil seleccionado (Outlined button con borde sutil Theme.outline-variant)
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    M3Button {
                                        text: "Cargar '" + root.selected-profile-name + "'";
                                        variant: "filled";
                                        btn-height: 36px;
                                        btn-padding-h: 16px;
                                        clicked => {
                                            root.load-hardware-profile(root.selected-profile-name);
                                        }
                                    }

                                    M3Button {
                                        text: "Exportar para compartir...";
                                        variant: "outlined";
                                        btn-height: 36px;
                                        btn-padding-h: 16px;
                                        clicked => {
                                            root.export-hardware-profile(root.selected-profile-name);
                                        }
                                    }
                                }
                            }
                        }

                        // Duración del Búfer de Repetición (Slider M3)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Duración del búfer de repetición";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: Theme.primary;
                                    }

                                    Rectangle {
                                        height: 26px;
                                        border-radius: Theme.radius-full;
                                        border-width: 0px;
                                        background: Theme.primary-container;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: root.replay-duration + " segundos";
                                                font-size: Theme.font-label-medium;
                                                font-weight: 700;
                                                color: Theme.on-primary-container;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Chips de Presets rápidos
                                HorizontalLayout {
                                    spacing: 8px;

                                    M3PresetChip {
                                        text: "15s";
                                        is-active: root.replay-duration == 15;
                                        clicked => {
                                            root.replay-duration = 15;
                                            root.select-replay-duration(15);
                                        }
                                    }

                                    M3PresetChip {
                                        text: "30s";
                                        is-active: root.replay-duration == 30;
                                        clicked => {
                                            root.replay-duration = 30;
                                            root.select-replay-duration(30);
                                        }
                                    }

                                    M3PresetChip {
                                        text: "45s";
                                        is-active: root.replay-duration == 45;
                                        clicked => {
                                            root.replay-duration = 45;
                                            root.select-replay-duration(45);
                                        }
                                    }

                                    M3PresetChip {
                                        text: "60s";
                                        is-active: root.replay-duration == 60;
                                        clicked => {
                                            root.replay-duration = 60;
                                            root.select-replay-duration(60);
                                        }
                                    }

                                    M3PresetChip {
                                        text: "90s";
                                        is-active: root.replay-duration == 90;
                                        clicked => {
                                            root.replay-duration = 90;
                                            root.select-replay-duration(90);
                                        }
                                    }

                                    M3PresetChip {
                                        text: "120s";
                                        is-active: root.replay-duration == 120;
                                        clicked => {
                                            root.replay-duration = 120;
                                            root.select-replay-duration(120);
                                        }
                                    }
                                }

                                M3Slider {
                                    minimum: 15.0;
                                    maximum: 120.0;
                                    value: root.replay-duration;
                                    changed(val) => {
                                        root.replay-duration = Math.round(val);
                                        root.select-replay-duration(root.replay-duration);
                                    }
                                }
                            }
                        }

                        // Almacenamiento y Formato
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 18px;

                                Text {
                                    text: "Almacenamiento y formato";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                // Carpeta
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Carpeta de guardado de replays";
                                        font-size: Theme.font-body-medium;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 42px;
                                            border-radius: Theme.radius-sm;
                                            background: Theme.surface-container-high;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                alignment: start;

                                                M3Icon {
                                                    name: "folder";
                                                    icon-size: 18px;
                                                    icon-color: Theme.primary;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: root.output-path;
                                                    font-size: Theme.font-body-medium;
                                                    color: Theme.on-surface;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        M3Button {
                                            text: "Examinar...";
                                            variant: "tonal";
                                            btn-height: 42px;
                                            btn-padding-h: 18px;
                                            clicked => {
                                                root.select-output-dir();
                                            }
                                        }
                                    }
                                }

                                // Formato
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Formato de contenedor";
                                        font-size: Theme.font-body-medium;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }

                                    Rectangle {
                                        height: 42px;
                                        width: 290px;
                                        border-radius: Theme.radius-full;
                                        background: Theme.surface-container-high;
                                        border-width: 0px;

                                        HorizontalLayout {
                                            padding: 4px;
                                            spacing: 4px;

                                            M3SegmentItem {
                                                horizontal-stretch: 1;
                                                text: ".mp4 (Universal)";
                                                is-selected: root.selected-format == "mp4";
                                                clicked => { root.selected-format = "mp4"; }
                                            }

                                            M3SegmentItem {
                                                horizontal-stretch: 1;
                                                text: ".mkv (Seguro)";
                                                is-selected: root.selected-format == "mkv";
                                                clicked => { root.selected-format = "mkv"; }
                                            }
                                        }
                                    }
                                }

                                // Modo Doble Clip (Discord)
                                VerticalLayout {
                                    spacing: 12px;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: "Modo doble clip (copia ligera para Discord)";
                                                font-size: Theme.font-body-medium;
                                                font-weight: 700;
                                                color: Theme.on-surface;
                                            }

                                            Text {
                                                text: "Genera automáticamente en segundo plano una segunda versión optimizada para compartir en Discord sin exceder el límite de peso.";
                                                font-size: Theme.font-body-small;
                                                color: Theme.on-surface-variant;
                                                wrap: word-wrap;
                                            }
                                        }

                                        M3Switch {
                                            y: (parent.height - self.height) / 2;
                                            checked: root.dual-clip;
                                            toggled(state) => {
                                                root.dual-clip = state;
                                                root.toggle-dual-clip(state);
                                            }
                                        }
                                    }

                                    if root.dual-clip: VerticalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: "Límite máximo de tamaño para Discord:";
                                            font-size: Theme.font-label-medium;
                                            font-weight: 600;
                                            color: Theme.primary;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            M3PresetChip {
                                                text: "10 MB (Discord Free)";
                                                is-active: root.discord-target-mb <= 10;
                                                clicked => {
                                                    root.discord-target-mb = 10;
                                                    root.set-discord-target-mb(10);
                                                }
                                            }

                                            M3PresetChip {
                                                text: "15 MB (Equilibrado)";
                                                is-active: root.discord-target-mb > 10 && root.discord-target-mb <= 15;
                                                clicked => {
                                                    root.discord-target-mb = 15;
                                                    root.set-discord-target-mb(15);
                                                }
                                            }

                                            M3PresetChip {
                                                text: "25 MB (Discord Nitro)";
                                                is-active: root.discord-target-mb > 15;
                                                clicked => {
                                                    root.discord-target-mb = 25;
                                                    root.set-discord-target-mb(25);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.radius-sm;
                                            background: Theme.surface-container-highest;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 8px;

                                                M3Icon {
                                                    name: "lightbulb";
                                                    icon-size: 16px;
                                                    icon-color: Theme.primary;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: "Se guardarán el archivo original (" + root.selected-format + ") y la copia ligera (<nombre>_discord." + root.selected-format + ")";
                                                    font-size: 12px;
                                                    color: Theme.on-surface-variant;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Selector interactivo de Atajos de Teclado (Sentence case, cero bordes)
                        M3Card {
                            content-padding: 18px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "Atajos de teclado globales (niri / Wayland)";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                }

                                Text {
                                    text: "Selecciona el atajo que te resulte más cómodo. Se actualiza automáticamente en niri sin reiniciar la sesión.";
                                    font-size: Theme.font-body-small;
                                    color: Theme.on-surface-variant;
                                }

                                // Atajo Guardar Replay
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Guardar replay instantáneo";
                                            font-size: Theme.font-body-medium;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: Theme.radius-full;
                                            border-width: 0px;
                                            background: Theme.primary-container;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: root.shortcut-save;
                                                    font-size: Theme.font-label-small;
                                                    font-weight: 800;
                                                    color: Theme.on-primary-container;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "Alt+F10 (Shadowplay)";
                                            is-active: root.shortcut-save == "Alt+F10";
                                            clicked => {
                                                root.shortcut-save = "Alt+F10";
                                                root.custom-save-text = "Alt+F10";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "F10 (Directo)";
                                            is-active: root.shortcut-save == "F10";
                                            clicked => {
                                                root.shortcut-save = "F10";
                                                root.custom-save-text = "F10";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "Mod+F10";
                                            is-active: root.shortcut-save == "Mod+F10";
                                            clicked => {
                                                root.shortcut-save = "Mod+F10";
                                                root.custom-save-text = "Mod+F10";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "Mod+R";
                                            is-active: root.shortcut-save == "Mod+R";
                                            clicked => {
                                                root.shortcut-save = "Mod+R";
                                                root.custom-save-text = "Mod+R";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                    }

                                    // Campo interactivo para atajo personalizado libre
                                    HorizontalLayout {
                                        spacing: 10px;
                                        M3InputField {
                                            horizontal-stretch: 1;
                                            icon-name: "keyboard";
                                            text <=> root.custom-save-text;
                                            placeholder: "Personalizado (ej. Ctrl+Shift+S, F8, Mod+Print)";
                                            accepted(val) => {
                                                if val != "" {
                                                    root.shortcut-save = val;
                                                    root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                                }
                                            }
                                        }
                                        M3Button {
                                            text: "Aplicar atajo";
                                            variant: "filled";
                                            btn-height: 42px;
                                            btn-padding-h: 18px;
                                            clicked => {
                                                if root.custom-save-text != "" {
                                                    root.shortcut-save = root.custom-save-text;
                                                    root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Atajo Alternar Grabación Continua
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Alternar grabación continua";
                                            font-size: Theme.font-body-medium;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: Theme.radius-full;
                                            border-width: 0px;
                                            background: Theme.secondary-container;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: root.shortcut-record;
                                                    font-size: Theme.font-label-small;
                                                    font-weight: 800;
                                                    color: Theme.on-secondary-container;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3PresetChip {
                                            text: "Alt+F9 (Shadowplay)";
                                            is-active: root.shortcut-record == "Alt+F9";
                                            clicked => {
                                                root.shortcut-record = "Alt+F9";
                                                root.custom-record-text = "Alt+F9";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "F9 (Directo)";
                                            is-active: root.shortcut-record == "F9";
                                            clicked => {
                                                root.shortcut-record = "F9";
                                                root.custom-record-text = "F9";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "Mod+F9";
                                            is-active: root.shortcut-record == "Mod+F9";
                                            clicked => {
                                                root.shortcut-record = "Mod+F9";
                                                root.custom-record-text = "Mod+F9";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                        M3PresetChip {
                                            text: "Mod+Shift+R";
                                            is-active: root.shortcut-record == "Mod+Shift+R";
                                            clicked => {
                                                root.shortcut-record = "Mod+Shift+R";
                                                root.custom-record-text = "Mod+Shift+R";
                                                root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                            }
                                        }
                                    }

                                    // Campo interactivo para atajo personalizado libre
                                    HorizontalLayout {
                                        spacing: 10px;
                                        M3InputField {
                                            horizontal-stretch: 1;
                                            icon-name: "keyboard";
                                            text <=> root.custom-record-text;
                                            placeholder: "Personalizado (ej. Ctrl+Shift+R, F9, Mod+Shift+Record)";
                                            accepted(val) => {
                                                if val != "" {
                                                    root.shortcut-record = val;
                                                    root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                                }
                                            }
                                        }
                                        M3Button {
                                            text: "Aplicar atajo";
                                            variant: "filled";
                                            btn-height: 42px;
                                            btn-padding-h: 18px;
                                            clicked => {
                                                if root.custom-record-text != "" {
                                                    root.shortcut-record = root.custom-record-text;
                                                    root.update-shortcuts(root.shortcut-save, root.shortcut-record);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // VISTA 4: GALERÍA DE REPLAYS (Sentence case, cero bordes)
                    // ---------------------------------------------------------
                    if root.active-view == 4: VerticalLayout {
                        spacing: 20px;

                        // Header Galería
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Galería de replays";
                                    font-size: 28px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Clips y repeticiones almacenados en " + root.output-path;
                                    font-size: 13px;
                                    color: Theme.on-surface-variant;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                M3Button {
                                    text: "Abrir carpeta";
                                    icon-name: "folder";
                                    variant: "tonal";
                                    btn-height: 38px;
                                    btn-padding-h: 16px;
                                    clicked => {
                                        root.open-output-folder();
                                    }
                                }

                                M3Button {
                                    text: "Refrescar";
                                    icon-name: "refresh";
                                    variant: "filled";
                                    btn-height: 38px;
                                    btn-padding-h: 16px;
                                    clicked => {
                                        root.refresh-gallery();
                                    }
                                }
                            }
                        }

                        // Estado Vacío o Lista de Clips de la Galería
                        if root.gallery-clips.length == 0: M3Card {
                            content-padding: 36px;
                            card-background: Theme.surface-container-low;
                            card-radius: Theme.radius-xl;
                            card-border-width: 0px;

                            VerticalLayout {
                                spacing: 16px;
                                alignment: center;

                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 30px;
                                    background: Theme.surface-container-high;
                                    border-width: 0px;

                                    M3Icon {
                                        name: "folder";
                                        icon-size: 28px;
                                        icon-color: Theme.primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: "No hay clips guardados aún";
                                        font-size: Theme.font-title-medium;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "No hay clips guardados aún en " + root.output-path;
                                        font-size: Theme.font-body-small;
                                        color: Theme.on-surface-variant;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                M3Button {
                                    text: "Refrescar";
                                    icon-name: "refresh";
                                    variant: "tonal";
                                    btn-height: 38px;
                                    btn-padding-h: 22px;
                                    clicked => {
                                        root.refresh-gallery();
                                    }
                                }
                            }
                        }

                        if root.gallery-clips.length > 0: VerticalLayout {
                            spacing: 10px;

                            for clip[idx] in root.gallery-clips: M3ClipCard {
                                filename: clip.filename;
                                file-size: clip.file-size;
                                date-text: clip.date-text;
                                duration-text: clip.duration-text;
                                filepath: clip.filepath;
                                is-discord: clip.is-discord;

                                play-clicked(path) => {
                                    root.play-clip(path);
                                }

                                folder-clicked(path) => {
                                    root.open-clip-folder(path);
                                }

                                compress-clicked(path) => {
                                    root.compress-clip-for-discord(path);
                                }
                            }
                        }

                        // Mensaje de estado informativo (Cero bordes)
                        M3Card {
                            content-padding: 16px;
                            card-background: Theme.surface-container;
                            card-radius: Theme.radius-lg;
                            card-border-width: 0px;

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;

                                M3Icon {
                                    name: "info";
                                    icon-size: 20px;
                                    icon-color: Theme.primary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Puedes abrir cualquier clip directamente en mpv o tu reproductor preferido, o copiar el archivo desde tu gestor de archivos para compartirlo en Discord.";
                                    font-size: Theme.font-body-small;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Banner / Toast flotante de notificación in-app M3 (Cero bordes)
        M3Toast {
            x: (parent.width - self.width) / 2;
            width: Math.min(parent.width - 40px, 460px);
            message: root.toast-message;
            icon-name: root.toast-icon != "" ? root.toast-icon : "info";
            is-visible: root.toast-visible;
        }
    }
}
