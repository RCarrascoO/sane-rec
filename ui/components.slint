        Theme.surface-container-high :
        Theme.surface-container;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;
        alignment: space-between;

        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: root.highlight ?
                    Theme.primary.with-alpha(0.2) :
                    Theme.surface-container-highest;
                border-width: 0px;

                if root.icon-name != "": M3Icon {
                    name: root.icon-name;
                    icon-size: 16px;
                    icon-color: root.highlight ? Theme.primary : Theme.on-surface-variant;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if root.icon-name == "" && root.icon-text != "": Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.icon-text;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.badge-text != "": Rectangle {
                height: 20px;
                border-radius: Theme.radius-full;
                border-width: 0px;
                background: root.highlight ? Theme.secondary-container : Theme.surface-container-highest;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.badge-text;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.highlight ? Theme.on-secondary-container : Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: end;
            Text {
                text: root.value;
                font-size: 18px;
                font-weight: 800;
                overflow: elide;
                color: root.highlight ? Theme.primary : Theme.on-surface;
            }
            Text {
                text: root.label;
                font-size: 11px;
                font-weight: 500;
                overflow: elide;
                color: Theme.on-surface-variant;
            }
        }
    }
}

