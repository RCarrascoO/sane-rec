// =============================================================================
// M3DropdownCard: Tarjeta desplegable M3 con Cero Bordes
// =============================================================================
export component M3DropdownCard inherits Rectangle {
    in-out property <string> title: "Opción";
    in-out property <string> description: "";
    in-out property <string> icon-name: "settings";
    in-out property <string> icon-text: "";
    in-out property <string> current-value: "Seleccionado";
    in-out property <bool> is-open: false;
    callback toggled();

    border-radius: Theme.radius-lg;
    border-width: 0px;
    background: Theme.surface-container-low;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 0px;

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.is-open = !root.is-open;
                root.toggled();
            }

            HorizontalLayout {
                min-height: 48px;
                spacing: 14px;
                alignment: space-between;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.surface-container-high;
                        border-width: 0px;
                        y: (parent.height - self.height) / 2;

                        if root.icon-name != "": M3Icon {
                            name: root.icon-name;
                            icon-size: 20px;
                            icon-color: Theme.primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        if root.icon-name == "" && root.icon-text != "": Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: root.icon-text;
                            font-size: 16px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.title;
                            font-size: Theme.font-title-small;
                            font-weight: 600;
                            color: Theme.on-surface;
                            overflow: elide;
                        }

                        if root.description != "": Text {
                            text: root.description;
                            font-size: Theme.font-body-small;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                        }
                    }
                }

                // Selector píldora tonal
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-full;
                    border-width: 0px;
                    background: root.is-open ? Theme.secondary-container : Theme.surface-container-high;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.current-value;
                            font-size: Theme.font-label-medium;
                            font-weight: 600;
                            color: root.is-open ? Theme.on-secondary-container : Theme.primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        M3Icon {
                            name: root.is-open ? "arrow_up" : "arrow_down";
                            icon-size: 14px;
                            icon-color: root.is-open ? Theme.on-secondary-container : Theme.on-surface-variant;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }

        Rectangle {
            clip: true;
            height: root.is-open ? options-box.preferred-height : 0px;
            animate height { duration: 150ms; easing: ease-out; }

            options-box := VerticalLayout {
                y: 0px;
                padding-top: 10px;
                spacing: 6px;
                @children
            }
        }
    }
}

// =============================================================================
// M3ClipCard: Fila de la Galería de Replays con Cero Bordes
// =============================================================================
export component M3ClipCard inherits Rectangle {
    in-out property <string> filename: "replay_2026-10-29.mp4";
    in-out property <string> file-size: "42.5 MB";
    in-out property <string> date-text: "Hoy, 19:20";
    in-out property <string> duration-text: "00:30";
    in-out property <string> filepath: "";
    in-out property <bool> is-discord: false;

    callback play-clicked(string);
    callback folder-clicked(string);
    callback compress-clicked(string);

    border-radius: Theme.radius-lg;
    border-width: 0px;
    background: Theme.surface-container;

    HorizontalLayout {
        padding: 14px;
        spacing: 16px;
        alignment: space-between;

        // Thumbnail tonal
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: Theme.radius-md;
            border-width: 0px;
            background: root.is-discord ? #5865F2.with-alpha(0.2) : Theme.secondary-container;
            y: (parent.height - self.height) / 2;

            M3Icon {
                name: root.is-discord ? "chat" : "play";
                icon-size: 22px;
                icon-color: root.is-discord ? #D0BCFF : Theme.on-secondary-container;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // Información del clip
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.filename;
                font-size: Theme.font-title-small;
                font-weight: 700;
                color: Theme.on-surface;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Tag duración
                Rectangle {
                    height: 20px;
                    border-radius: Theme.radius-full;
                    border-width: 0px;
                    background: Theme.surface-container-high;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: root.duration-text;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.is-discord: Rectangle {
                    height: 20px;
                    border-radius: Theme.radius-full;
                    border-width: 0px;
                    background: #5865F2.with-alpha(0.25);
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "Discord";
                            font-size: 11px;
                            font-weight: 700;
                            color: #D0BCFF;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.file-size + " • " + root.date-text;
                    font-size: Theme.font-body-small;
                    color: Theme.on-surface-variant;
                    vertical-alignment: center;
                }
            }
        }

        // Acciones: Botones sin emojis
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            y: (parent.height - self.height) / 2;

            if !root.is-discord: M3Button {
                text: "Discord";
                variant: "tonal";
                btn-height: 36px;
                btn-padding-h: 14px;
                clicked => {
                    root.compress-clicked(root.filepath != "" ? root.filepath : root.filename);
                }
            }

            M3Button {
                text: "Ver";
                icon-name: "play";
                variant: "filled";
                btn-height: 36px;
                btn-padding-h: 16px;
                clicked => {
                    root.play-clicked(root.filepath != "" ? root.filepath : root.filename);
                }
            }

            M3Button {
                text: "Carpeta";
                icon-name: "folder";
                variant: "outlined";
                btn-height: 36px;
                btn-padding-h: 14px;
                clicked => {
                    root.folder-clicked(root.filepath != "" ? root.filepath : root.filename);
                }
            }
        }
    }
}

// =============================================================================
// M3VuMeter: Medidor VU con bordes redondeados (radius-full) y paleta armónica M3
// =============================================================================
export component M3VuMeter inherits Rectangle {
    in-out property <float> peak-level: 0.0; // 0.0 a 1.0
    in-out property <bool> active: true;
    in-out property <string> label: "";

    height: 20px;
    background: Colors.transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: stretch;

        if root.label != "": Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: Theme.on-surface-variant;
            vertical-alignment: center;
            width: 48px;
        }

        // Barra con radius-full (999px)
        bar-bg := Rectangle {
            horizontal-stretch: 1;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-full;
            background: Theme.surface-container-highest;
            border-width: 0px;
            clip: true;

            // Relleno dinámico armónico con M3
            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: root.active ? Math.clamp(root.peak-level, 0.0, 1.0) * parent.width : 0px;
                border-radius: Theme.radius-full;
                background: root.peak-level > 0.85 ?
                    Theme.error :
                    (root.peak-level > 0.65 ? Theme.warning : Theme.success);

                animate width { duration: 60ms; easing: ease-out; }
                animate background { duration: 100ms; }
            }
        }

        // Indicador numérico
        Text {
            text: root.active ? (Math.round(root.peak-level * 100) + "%") : "Mudo";
            font-size: 11px;
            font-weight: 700;
            color: !root.active ? Theme.on-surface-variant.with-alpha(0.5) :
                   root.peak-level > 0.85 ? Theme.error :
                   Theme.on-surface-variant;
            vertical-alignment: center;
            horizontal-alignment: end;
            width: 40px;
        }
    }
}

// =============================================================================
// M3Slider: Slider M3 Expressive (pista gruesa 12px, radius-full, thumb Theme.primary)
// =============================================================================
export component M3Slider inherits Rectangle {
    in-out property <float> minimum: 0.0;
    in-out property <float> maximum: 1.0;
    in-out property <float> value: 0.5;
    in-out property <bool> enabled: true;

    callback changed(float);

    height: 36px;
    background: Colors.transparent;

    track-bg := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 12px;
        border-radius: Theme.radius-full;
        background: Theme.surface-container-highest;
        border-width: 0px;
        clip: true;

        track-active := Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: Math.clamp((root.value - root.minimum) / Math.max(0.0001, root.maximum - root.minimum), 0.0, 1.0) * parent.width;
            border-radius: Theme.radius-full;
            background: root.enabled ? Theme.primary : Theme.outline.with-alpha(0.38);

            animate width { duration: 50ms; }
        }
    }

    thumb := Rectangle {
        property <float> progress: Math.clamp((root.value - root.minimum) / Math.max(0.0001, root.maximum - root.minimum), 0.0, 1.0);
        x: self.progress * (root.width - self.width);
        y: (root.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 0px;
        background: root.enabled ? Theme.primary : Theme.outline;
        drop-shadow-color: Colors.black.with-alpha(0.35);
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;

        animate x { duration: 50ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;

        moved => {
            if self.pressed {
                root.update-pos(self.mouse-x);
            }
        }

        clicked => {
            root.update-pos(self.mouse-x);
        }
    }

    function update-pos(mx: length) {
        let total-w = root.width / 1px;
        let pos-x = mx / 1px;
        let fraction = Math.clamp(pos-x / Math.max(1.0, total-w), 0.0, 1.0);
        root.value = root.minimum + fraction * (root.maximum - root.minimum);
        root.changed(root.value);
    }
}

// =============================================================================
// M3Toast: Notificación emergente M3 con Cero Bordes y Sombra Suave
// =============================================================================
export component M3Toast inherits Rectangle {
    in-out property <string> message: "";
    in-out property <string> icon-name: "info";
    in-out property <string> icon-text: "";
    in-out property <bool> is-visible: false;

    height: 48px;
    border-radius: Theme.radius-full;
    background: Theme.surface-container-highest;
    border-width: 0px;
    drop-shadow-color: Colors.black.with-alpha(0.45);
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    opacity: root.is-visible ? 1.0 : 0.0;
    y: root.is-visible ? 16px : -60px;

    animate opacity { duration: 250ms; easing: ease-out; }
    animate y { duration: 300ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        alignment: center;

        if root.icon-name != "": M3Icon {
            name: root.icon-name;
            icon-size: 18px;
            icon-color: Theme.primary;
            y: (parent.height - self.height) / 2;
        }

        if root.icon-name == "" && root.icon-text != "": Text {
            text: root.icon-text;
            font-size: 16px;
            vertical-alignment: center;
        }

        Text {
            text: root.message;
            font-size: Theme.font-label-large;
            font-weight: 600;
            color: Theme.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// =============================================================================
// M3InputField: Campo de texto con estilo M3 Expressive
// =============================================================================
export component M3InputField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "";
    in-out property <string> icon-name: "keyboard";
    in-out property <string> icon-text: "";
    in-out property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    height: 42px;
    border-radius: Theme.radius-sm;
    background: Theme.surface-container-high;
    border-width: input.has-focus ? 1.5px : 0px;
    border-color: input.has-focus ? Theme.primary : Colors.transparent;

    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: center;

        if root.icon-name != "": M3Icon {
            name: root.icon-name;
            icon-size: 16px;
            icon-color: Theme.on-surface-variant;
            y: (parent.height - self.height) / 2;
        }

        if root.icon-name == "" && root.icon-text != "": Text {
            text: root.icon-text;
            font-size: 14px;
            vertical-alignment: center;
            opacity: 0.8;
        }

        input := TextInput {
            horizontal-stretch: 1;
            font-size: Theme.font-body-medium;
            color: Theme.on-surface;
            vertical-alignment: center;
            single-line: true;
            enabled: root.enabled;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
}
