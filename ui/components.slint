// Material Design 3 (M3 Expressive) Components for sane-rec
import { M3Theme } from "theme.slint";

// =============================================================================
// M3Card: Contenedor de superficie M3 con bordes redondeados y padding
// =============================================================================
export component M3Card inherits Rectangle {
    in-out property <length> content-padding: M3Theme.space-xl;
    in-out property <color> card-background: M3Theme.surface-container;
    in-out property <color> card-border-color: M3Theme.outline-variant.with-alpha(0.35);
    in-out property <length> card-border-width: 1px;
    in-out property <length> card-radius: M3Theme.corner-large;

    background: root.card-background;
    border-radius: root.card-radius;
    border-color: root.card-border-color;
    border-width: root.card-border-width;
    clip: true;

    VerticalLayout {
        padding: root.content-padding;
        @children
    }
}

// =============================================================================
// M3Button: Botón M3 con variantes filled, tonal y outlined
// =============================================================================
export component M3Button inherits Rectangle {
    in-out property <string> text: "Acción";
    in-out property <string> variant: "filled"; // "filled" | "tonal" | "outlined"
    in-out property <bool> enabled: true;
    in-out property <length> btn-height: 42px;
    in-out property <length> btn-padding-h: 22px;
    in-out property <string> icon-text: "";

    callback clicked();

    height: root.btn-height;
    border-radius: M3Theme.corner-full;
    clip: true;

    // Fondo interactivo
    background: !root.enabled ?
        (root.variant == "outlined" ? Colors.transparent : M3Theme.surface-container-highest.with-alpha(0.38)) :
        touch.pressed ?
            (root.variant == "filled" ? M3Theme.primary.darker(0.18) :
             root.variant == "tonal" ? M3Theme.secondary-container.darker(0.18) :
             M3Theme.primary.with-alpha(0.18)) :
        touch.has-hover ?
            (root.variant == "filled" ? M3Theme.primary.darker(0.08) :
             root.variant == "tonal" ? M3Theme.secondary-container.darker(0.08) :
             M3Theme.primary.with-alpha(0.08)) :
        (root.variant == "filled" ? M3Theme.primary :
         root.variant == "tonal" ? M3Theme.secondary-container :
         Colors.transparent);

    border-width: root.variant == "outlined" ? 1px : 0px;
    border-color: !root.enabled ? M3Theme.outline.with-alpha(0.2) :
                  touch.has-hover ? M3Theme.primary :
                  M3Theme.outline;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: root.btn-padding-h;
        padding-right: root.btn-padding-h;
        spacing: 8px;
        alignment: center;

        if root.icon-text != "": Text {
            text: root.icon-text;
            font-size: 16px;
            vertical-alignment: center;
            color: !root.enabled ? M3Theme.on-surface.with-alpha(0.38) :
                   root.variant == "filled" ? M3Theme.on-primary :
                   root.variant == "tonal" ? M3Theme.on-secondary-container :
                   M3Theme.primary;
        }

        Text {
            text: root.text;
            font-size: M3Theme.font-label-large;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
            color: !root.enabled ? M3Theme.on-surface.with-alpha(0.38) :
                   root.variant == "filled" ? M3Theme.on-primary :
                   root.variant == "tonal" ? M3Theme.on-secondary-container :
                   M3Theme.primary;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// =============================================================================
// M3Switch: Toggle M3 con animación suave
// =============================================================================
export component M3Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled(bool);

    width: 52px;
    height: 32px;
    border-radius: 16px;

    background: !root.enabled ? M3Theme.surface-container-highest.with-alpha(0.38) :
                root.checked ? M3Theme.primary : M3Theme.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: !root.enabled ? M3Theme.outline.with-alpha(0.2) : M3Theme.outline;

    animate background { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 180ms; easing: ease-out; }

    thumb := Rectangle {
        y: (parent.height - self.height) / 2;
        x: root.checked ?
            (parent.width - self.width - 4px) :
            4px;

        width: root.checked ? 24px : 16px;
        height: root.checked ? 24px : 16px;
        border-radius: 12px;

        background: !root.enabled ? M3Theme.on-surface.with-alpha(0.38) :
                    root.checked ? M3Theme.on-primary : M3Theme.outline;

        animate x { duration: 180ms; easing: ease-out; }
        animate width { duration: 150ms; easing: ease-out; }
        animate height { duration: 150ms; easing: ease-out; }
        animate background { duration: 180ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// =============================================================================
// M3Badge / M3StatusChip: Indicador de estado con halo circular de color
// =============================================================================
export component M3StatusChip inherits Rectangle {
    in-out property <string> text: "Detenido";
    in-out property <string> status: "idle"; // "recording" | "active" | "idle"

    height: 30px;
    border-radius: M3Theme.corner-full;

    background: root.status == "recording" ? M3Theme.error-container.with-alpha(0.45) :
                root.status == "active" ? M3Theme.success-container.with-alpha(0.4) :
                M3Theme.surface-container-high;

    border-width: 1px;
    border-color: root.status == "recording" ? M3Theme.error.with-alpha(0.6) :
                  root.status == "active" ? M3Theme.success.with-alpha(0.6) :
                  M3Theme.outline-variant;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        // Halo exterior
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: (parent.height - self.height) / 2;
            background: root.status == "recording" ? M3Theme.error.with-alpha(0.25) :
                        root.status == "active" ? M3Theme.success.with-alpha(0.25) :
                        Colors.transparent;

            // Dot central
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.status == "recording" ? M3Theme.error :
                            root.status == "active" ? M3Theme.success :
                            M3Theme.outline;
            }
        }

        Text {
            text: root.text;
            font-size: M3Theme.font-label-medium;
            font-weight: 700;
            vertical-alignment: center;
            color: root.status == "recording" ? M3Theme.error :
                   root.status == "active" ? M3Theme.success :
                   M3Theme.on-surface-variant;
        }
    }
}

// =============================================================================
// M3ProfileTile: Tarjeta/Chip seleccionable para los perfiles de hardware
// =============================================================================
export component M3ProfileTile inherits Rectangle {
    in-out property <string> title: "Perfil";
    in-out property <string> subtitle: "";
    in-out property <string> badge-text: "";
    in-out property <string> warning-text: "";
    in-out property <bool> is-selected: false;
    in-out property <string> icon-text: "⚡";

    callback clicked();

    border-radius: M3Theme.corner-medium;
    background: root.is-selected ?
        M3Theme.primary-container :
        touch.has-hover ?
            M3Theme.surface-container-highest :
            M3Theme.surface-container-high;

    border-width: root.is-selected ? 1.5px : 1px;
    border-color: root.is-selected ?
        M3Theme.primary :
        touch.has-hover ?
            M3Theme.outline :
            M3Theme.outline-variant.with-alpha(0.5);

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            alignment: center;

            // Icono
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: root.is-selected ?
                    M3Theme.primary.with-alpha(0.2) :
                    M3Theme.surface-container;
                y: (parent.height - self.height) / 2;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.icon-text;
                    font-size: 16px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Textos
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.title;
                        font-size: M3Theme.font-title-small;
                        font-weight: root.is-selected ? 700 : 600;
                        color: root.is-selected ? M3Theme.on-primary-container : M3Theme.on-surface;
                        vertical-alignment: center;
                    }

                    if root.badge-text != "": Rectangle {
                        height: 20px;
                        border-radius: 10px;
                        background: root.badge-text == "Experimental" ?
                            M3Theme.error-container :
                            (root.is-selected ? M3Theme.primary : M3Theme.secondary-container);
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.badge-text;
                                font-size: M3Theme.font-label-small;
                                font-weight: 700;
                                vertical-alignment: center;
                                color: root.badge-text == "Experimental" ?
                                    M3Theme.error :
                                    (root.is-selected ? M3Theme.on-primary : M3Theme.on-secondary-container);
                            }
                        }
                    }
                }

                if root.warning-text != "": Rectangle {
                    height: 22px;
                    border-radius: 6px;
                    background: M3Theme.error-container.with-alpha(0.85);
                    border-width: 1px;
                    border-color: M3Theme.error.with-alpha(0.5);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: start;

                        Text {
                            text: "⚠️";
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.warning-text;
                            font-size: 11px;
                            font-weight: 700;
                            color: M3Theme.error;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: M3Theme.font-body-small;
                    color: root.is-selected ?
                        M3Theme.on-primary-container.with-alpha(0.8) :
                        M3Theme.on-surface-variant;
                }
            }

            // Radio dot indicator
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                y: (parent.height - self.height) / 2;
                border-width: 2px;
                border-color: root.is-selected ? M3Theme.primary : M3Theme.outline;
                background: Colors.transparent;

                if root.is-selected: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: M3Theme.primary;
                }
            }
        }
    }
}

// =============================================================================
// M3SegmentItem: Opción individual de selector segmentado
// =============================================================================
export component M3SegmentItem inherits Rectangle {
    in-out property <string> text: "Opción";
    in-out property <bool> is-selected: false;
    callback clicked();

    border-radius: M3Theme.corner-small;
    background: root.is-selected ?
        M3Theme.secondary-container :
        touch.has-hover ?
            M3Theme.surface-container-highest :
            Colors.transparent;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;

            Text {
                text: root.text;
                font-size: M3Theme.font-label-medium;
                font-weight: root.is-selected ? 700 : 500;
                vertical-alignment: center;
                color: root.is-selected ?
                    M3Theme.on-secondary-container :
                    M3Theme.on-surface-variant;
            }
        }
    }
}

// =============================================================================
// M3PresetChip: Chip pequeño para presets numéricos (ej. 15s, 30s, 60s)
// =============================================================================
export component M3PresetChip inherits Rectangle {
    in-out property <string> text: "30s";
    in-out property <bool> is-active: false;
    callback clicked();

    height: 32px;
    border-radius: 16px;
    background: root.is-active ?
        M3Theme.primary :
        touch.has-hover ?
            M3Theme.surface-container-highest :
            M3Theme.surface-container-high;

    border-width: 1px;
    border-color: root.is-active ?
        M3Theme.primary :
        M3Theme.outline-variant;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: center;

            Text {
                text: root.text;
                font-size: M3Theme.font-label-medium;
                font-weight: root.is-active ? 700 : 500;
                vertical-alignment: center;
                color: root.is-active ?
                    M3Theme.on-primary :
                    M3Theme.on-surface-variant;
            }
        }
    }
}

// =============================================================================
// M3NavItem: Botón en píldora para el Navigation Rail con indicador tonal
// =============================================================================
export component M3NavItem inherits Rectangle {
    in-out property <string> icon-text: "🎬";
    in-out property <string> text: "Dashboard";
    in-out property <string> badge-text: "";
    in-out property <bool> is-selected: false;
    in-out property <bool> compact: false;
    callback clicked();

    height: root.compact ? 52px : 48px;
    border-radius: root.compact ? M3Theme.corner-medium : M3Theme.corner-full;
    background: root.is-selected ?
        M3Theme.primary-container :
        touch.has-hover ?
            M3Theme.surface-container-high :
            Colors.transparent;

    animate background { duration: 160ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        if !root.compact: HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            alignment: start;

            Text {
                text: root.icon-text;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.text;
                font-size: M3Theme.font-label-large;
                font-weight: root.is-selected ? 700 : 500;
                vertical-alignment: center;
                overflow: elide;
                color: root.is-selected ?
                    M3Theme.on-primary-container :
                    M3Theme.on-surface-variant;
            }

            if root.badge-text != "": Rectangle {
                height: 20px;
                border-radius: 10px;
                background: root.is-selected ? M3Theme.primary : M3Theme.surface-container-highest;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: root.badge-text;
                        font-size: M3Theme.font-label-small;
                        font-weight: 700;
                        color: root.is-selected ? M3Theme.on-primary : M3Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.compact: VerticalLayout {
            alignment: center;
            spacing: 2px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: root.icon-text;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                font-size: 9px;
                font-weight: root.is-selected ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                color: root.is-selected ?
                    M3Theme.on-primary-container :
                    M3Theme.on-surface-variant;
            }
        }
    }
}

// =============================================================================
// M3NavigationRail: Barra lateral de navegación vertical M3 Expressive
// =============================================================================
export component M3NavigationRail inherits Rectangle {
    in-out property <int> active-view: 0;
    in-out property <bool> compact: false;
    callback view-selected(int);

    width: root.compact ? 64px : 180px;
    background: M3Theme.surface-container;
    clip: true;

    animate width { duration: 160ms; easing: ease-out; }

    // Borde separador lateral derecho
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: M3Theme.outline-variant.with-alpha(0.35);
    }

    VerticalLayout {
        padding-left: root.compact ? 6px : 12px;
        padding-right: root.compact ? 6px : 12px;
        padding-top: 18px;
        padding-bottom: 16px;
        spacing: 16px;

        // Logo y Brand
        if !root.compact: HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: M3Theme.primary-container;
                y: (parent.height - self.height) / 2;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "⏺";
                    font-size: 19px;
                    color: M3Theme.primary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "sane-rec";
                    font-size: M3Theme.font-title-medium;
                    font-weight: 800;
                    color: M3Theme.on-surface;
                }

                Text {
                    text: "M3 Expressive";
                    font-size: M3Theme.font-label-small;
                    color: M3Theme.on-surface-variant;
                }
            }
        }

        if root.compact: Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 19px;
            background: M3Theme.primary-container;
            x: (parent.width - self.width) / 2;

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "⏺";
                font-size: 20px;
                color: M3Theme.primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Separador horizontal sutil
        Rectangle {
            height: 1px;
            background: M3Theme.outline-variant.with-alpha(0.3);
        }

        // Elementos de Navegación (Píldoras M3)
        VerticalLayout {
            spacing: 6px;

            M3NavItem {
                compact: root.compact;
                icon-text: "🎬";
                text: "Dashboard";
                is-selected: root.active-view == 0;
                clicked => {
                    root.active-view = 0;
                    root.view-selected(0);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-text: "🖥️";
                text: "Fuentes";
                is-selected: root.active-view == 1;
                clicked => {
                    root.active-view = 1;
                    root.view-selected(1);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-text: "🎙️";
                text: "Audio";
                is-selected: root.active-view == 2;
                clicked => {
                    root.active-view = 2;
                    root.view-selected(2);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-text: "⚙️";
                text: "Ajustes";
                is-selected: root.active-view == 3;
                clicked => {
                    root.active-view = 3;
                    root.view-selected(3);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-text: "📂";
                text: "Galería";
                is-selected: root.active-view == 4;
                clicked => {
                    root.active-view = 4;
                    root.view-selected(4);
                }
            }
        }

        // Espaciador expansible
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer informativo
        if !root.compact: Rectangle {
            height: 48px;
            border-radius: M3Theme.corner-medium;
            background: M3Theme.surface-container-high.with-alpha(0.6);
            border-width: 1px;
            border-color: M3Theme.outline-variant.with-alpha(0.25);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: M3Theme.success;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: "Wayland / niri";
                        font-size: M3Theme.font-label-small;
                        font-weight: 700;
                        color: M3Theme.on-surface;
                    }

                    Text {
                        text: "PipeWire • 60 FPS";
                        font-size: 10px;
                        color: M3Theme.on-surface-variant;
                    }
                }
            }
        }

        if root.compact: Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: M3Theme.surface-container-high.with-alpha(0.6);
            border-width: 1px;
            border-color: M3Theme.outline-variant.with-alpha(0.25);
            x: (parent.width - self.width) / 2;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: M3Theme.success;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// =============================================================================
// M3MetricTile: Métrica de alto impacto visual para el Dashboard
// =============================================================================
export component M3MetricTile inherits Rectangle {
    in-out property <string> icon-text: "⚡";
    in-out property <string> value: "60 FPS";
    in-out property <string> label: "Tasa de Refresco";
    in-out property <string> badge-text: "";
    in-out property <bool> highlight: false;

    min-height: 98px;
    preferred-height: 106px;
    border-radius: M3Theme.corner-medium;
    background: root.highlight ?
        M3Theme.primary-container.with-alpha(0.35) :
        M3Theme.surface-container-high;
    border-width: 1px;
    border-color: root.highlight ?
        M3Theme.primary.with-alpha(0.4) :
        M3Theme.outline-variant.with-alpha(0.35);

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        alignment: space-between;

        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.highlight ?
                    M3Theme.primary.with-alpha(0.25) :
                    M3Theme.surface-container-highest;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.icon-text;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.badge-text != "": Rectangle {
                height: 18px;
                border-radius: 9px;
                background: root.highlight ? M3Theme.primary : M3Theme.surface-container-highest;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.badge-text;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.highlight ? M3Theme.on-primary : M3Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: end;
            Text {
                text: root.value;
                font-size: 18px;
                font-weight: 800;
                overflow: elide;
                color: root.highlight ? M3Theme.primary : M3Theme.on-surface;
            }
            Text {
                text: root.label;
                font-size: 11px;
                font-weight: 500;
                overflow: elide;
                color: M3Theme.on-surface-variant;
            }
        }
    }
}

// =============================================================================
// M3OptionItem: Opción de selección con checkmark y badge
// =============================================================================
export component M3OptionItem inherits Rectangle {
    in-out property <string> text: "Opción";
    in-out property <string> badge-text: "";
    in-out property <bool> is-selected: false;
    callback clicked();

    height: 38px;
    border-radius: M3Theme.corner-small;
    background: root.is-selected ?
        M3Theme.primary-container :
        touch.has-hover ?
            M3Theme.surface-container-highest :
            M3Theme.surface-container;

    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.is-selected ? "✓" : " ";
                    font-size: 13px;
                    font-weight: 700;
                    color: root.is-selected ? M3Theme.primary : Colors.transparent;
                    vertical-alignment: center;
                }

                Text {
                    text: root.text;
                    font-size: M3Theme.font-label-medium;
                    font-weight: root.is-selected ? 700 : 500;
                    color: root.is-selected ? M3Theme.on-primary-container : M3Theme.on-surface;
                    vertical-alignment: center;
                }
            }

            if root.badge-text != "": Rectangle {
                height: 18px;
                border-radius: 9px;
                background: root.is-selected ? M3Theme.primary : M3Theme.surface-container-high;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.badge-text;
                        font-size: 10px;
                        font-weight: 600;
                        color: root.is-selected ? M3Theme.on-primary : M3Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// =============================================================================
// M3DropdownCard: Tarjeta compacta estilo elemento de lista M3 con selector desplegable
// =============================================================================
export component M3DropdownCard inherits Rectangle {
    in-out property <string> title: "Opción";
    in-out property <string> description: "";
    in-out property <string> icon-text: "⚙️";
    in-out property <string> current-value: "Seleccionado";
    in-out property <bool> is-open: false;
    callback toggled();

    border-radius: M3Theme.corner-medium;
    background: M3Theme.surface-container-high;
    border-width: 1px;
    border-color: root.is-open ? M3Theme.primary : M3Theme.outline-variant.with-alpha(0.35);

    animate border-color { duration: 150ms; }

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 0px;

        // Fila horizontal compacta estilo M3 list item (56px a 64px de alto)
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.is-open = !root.is-open;
                root.toggled();
            }

            HorizontalLayout {
                min-height: 44px;
                spacing: 12px;
                alignment: space-between;

                // Fila izquierda: Icono y Textos
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    alignment: start;

                    // Icono circular
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: M3Theme.surface-container;
                        y: (parent.height - self.height) / 2;

                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: root.icon-text;
                            font-size: 16px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // Columna vertical compacta: título y descripción
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.title;
                            font-size: M3Theme.font-title-small;
                            font-weight: 600;
                            color: M3Theme.on-surface;
                            overflow: elide;
                        }

                        if root.description != "": Text {
                            text: root.description;
                            font-size: M3Theme.font-body-small;
                            color: M3Theme.on-surface-variant;
                            overflow: elide;
                        }
                    }
                }

                // Derecha: Selector / Dropdown en píldora estilizada
                Rectangle {
                    height: 32px;
                    border-radius: M3Theme.corner-small;
                    background: root.is-open ? M3Theme.primary-container : M3Theme.surface-container-highest;
                    border-width: 1px;
                    border-color: root.is-open ? M3Theme.primary : M3Theme.outline-variant.with-alpha(0.5);
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.current-value;
                            font-size: M3Theme.font-label-medium;
                            font-weight: 600;
                            color: root.is-open ? M3Theme.on-primary-container : M3Theme.primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.is-open ? "▲" : "▼";
                            font-size: 10px;
                            color: root.is-open ? M3Theme.on-primary-container : M3Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Contenedor expandible para opciones
        Rectangle {
            clip: true;
            height: root.is-open ? options-box.preferred-height : 0px;
            animate height { duration: 150ms; easing: ease-out; }

            options-box := VerticalLayout {
                y: 0px;
                padding-top: 8px;
                spacing: 6px;
                @children
            }
        }
    }
}

// =============================================================================
// M3ClipCard: Elemento de lista para la Galería de Replays
// =============================================================================
export component M3ClipCard inherits Rectangle {
    in-out property <string> filename: "replay_2026-10-29.mp4";
    in-out property <string> file-size: "42.5 MB";
    in-out property <string> date-text: "Hoy, 19:20";
    in-out property <string> duration-text: "00:30";
    in-out property <string> filepath: "";

    callback play-clicked(string);
    callback folder-clicked(string);

    border-radius: M3Theme.corner-medium;
    background: M3Theme.surface-container-high;
    border-width: 1px;
    border-color: M3Theme.outline-variant.with-alpha(0.35);

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        alignment: space-between;

        // Thumbnail / Icono de Video
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: M3Theme.corner-small;
            background: M3Theme.primary-container;
            y: (parent.height - self.height) / 2;

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "🎬";
                font-size: 20px;
            }
        }

        // Información del clip
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.filename;
                font-size: M3Theme.font-title-small;
                font-weight: 700;
                color: M3Theme.on-surface;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                // Tag duración
                Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: M3Theme.secondary-container;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "⏱️ " + root.duration-text;
                            font-size: 11px;
                            font-weight: 600;
                            color: M3Theme.on-secondary-container;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.file-size + " • " + root.date-text;
                    font-size: M3Theme.font-body-small;
                    color: M3Theme.on-surface-variant;
                    vertical-alignment: center;
                }
            }
        }

        // Acciones: Reproducir y Carpeta
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            y: (parent.height - self.height) / 2;

            M3Button {
                text: "Ver";
                icon-text: "▶";
                variant: "filled";
                btn-height: 36px;
                btn-padding-h: 14px;
                clicked => {
                    root.play-clicked(root.filepath != "" ? root.filepath : root.filename);
                }
            }

            M3Button {
                text: "Carpeta";
                icon-text: "📁";
                variant: "outlined";
                btn-height: 36px;
                btn-padding-h: 12px;
                clicked => {
                    root.folder-clicked(root.filepath != "" ? root.filepath : root.filename);
                }
            }
        }
    }
}

// =============================================================================
// M3VuMeter: Indicador visual en tiempo real de picos de audio (VU Meter)
// =============================================================================
export component M3VuMeter inherits Rectangle {
    in-out property <float> peak-level: 0.0; // 0.0 a 1.0
    in-out property <bool> active: true;
    in-out property <string> label: "";

    height: 18px;
    background: Colors.transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;

        if root.label != "": Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: M3Theme.on-surface-variant;
            vertical-alignment: center;
            width: 45px;
        }

        // Barra de nivel VU
        bar-bg := Rectangle {
            horizontal-stretch: 1;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: M3Theme.surface-container-highest;
            clip: true;

            // Relleno dinámico con animación suave
            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: root.active ? Math.clamp(root.peak-level, 0.0, 1.0) * parent.width : 0px;
                border-radius: 4px;
                background: root.peak-level > 0.85 ?
                    M3Theme.error :
                    (root.peak-level > 0.65 ? #eab308 : #22c55e);

                animate width { duration: 60ms; easing: ease-out; }
                animate background { duration: 100ms; }
            }
        }

        // Indicador numérico
        Text {
            text: root.active ? (Math.round(root.peak-level * 100) + "%") : "Mudo";
            font-size: 11px;
            font-weight: 700;
            color: !root.active ? M3Theme.on-surface-variant.with-alpha(0.5) :
                   root.peak-level > 0.85 ? M3Theme.error :
                   M3Theme.on-surface-variant;
            vertical-alignment: center;
            horizontal-alignment: end;
            width: 38px;
        }
    }
}

// =============================================================================
// M3Toast: Notificación flotante / Banner emergente M3
// =============================================================================
export component M3Toast inherits Rectangle {
    in-out property <string> message: "";
    in-out property <string> icon-text: "🎬";
    in-out property <bool> is-visible: false;

    height: 44px;
    border-radius: 22px;
    background: M3Theme.surface-container-highest;
    border-width: 1px;
    border-color: M3Theme.primary.with-alpha(0.5);
    drop-shadow-color: Colors.black.with-alpha(0.45);
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    opacity: root.is-visible ? 1.0 : 0.0;
    y: root.is-visible ? 14px : -60px;

    animate opacity { duration: 250ms; easing: ease-out; }
    animate y { duration: 300ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;

        Text {
            text: root.icon-text;
            font-size: 16px;
            vertical-alignment: center;
        }

        Text {
            text: root.message;
            font-size: M3Theme.font-label-large;
            font-weight: 600;
            color: M3Theme.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// =============================================================================
// M3InputField: Campo de texto con estilo Material Design 3
// =============================================================================
export component M3InputField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "";
    in-out property <string> icon-text: "⌨️";
    in-out property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    height: 38px;
    border-radius: M3Theme.corner-small;
    background: M3Theme.surface-container-high;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? M3Theme.primary : M3Theme.outline-variant.with-alpha(0.5);

    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.icon-text;
            font-size: 14px;
            vertical-alignment: center;
            opacity: 0.8;
        }

        input := TextInput {
            horizontal-stretch: 1;
            font-size: M3Theme.font-body-medium;
            color: M3Theme.on-surface;
            vertical-alignment: center;
            single-line: true;
            enabled: root.enabled;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
}


