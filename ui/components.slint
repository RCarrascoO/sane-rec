import { Theme, M3Theme } from "theme.slint";

// =============================================================================
// M3Icon: Iconografía Monocromática Nativa Slint (Material Symbols Rounded)
// =============================================================================
export component M3Icon inherits Rectangle {
    in-out property <string> name: "";
    in-out property <color> icon-color: Theme.on-surface;
    in-out property <length> icon-size: 20px;

    width: root.icon-size;
