// =============================================================================
// M3Card: Contenedor con Tonal Elevation (Cero Bordes, Radios M3 Expressive)
// =============================================================================
export component M3Card inherits Rectangle {
    in-out property <length> content-padding: Theme.radius-lg;
    in-out property <color> card-background: Theme.surface-container-low;
    in-out property <color> card-border-color: Colors.transparent;
    in-out property <length> card-border-width: 0px;
    in-out property <length> card-radius: Theme.radius-xl;

    background: root.card-background;
    border-radius: root.card-radius;
    border-color: root.card-border-color;
    border-width: root.card-border-width;
    clip: true;

    VerticalLayout {
        padding: root.content-padding;
        @children
    }
}

// =============================================================================
// M3Button: Botón M3 Expressive con variantes filled, tonal y outlined
// =============================================================================
export component M3Button inherits Rectangle {
    in-out property <string> text: "Acción";
    in-out property <string> variant: "filled"; // "filled" | "tonal" | "outlined"
    in-out property <bool> enabled: true;
    in-out property <length> btn-height: 44px;
    in-out property <length> btn-padding-h: 22px;
    in-out property <string> icon-name: "";
    in-out property <string> icon-text: "";

    callback clicked();

    height: root.btn-height;
    border-radius: Theme.radius-full;
    clip: true;

    // Fondo interactivo por elevación tonal
    background: !root.enabled ?
        (root.variant == "outlined" ? Colors.transparent : Theme.surface-container-highest.with-alpha(0.38)) :
        touch.pressed ?
            (root.variant == "filled" ? Theme.primary.darker(0.18) :
             root.variant == "tonal" ? Theme.secondary-container.darker(0.18) :
             Theme.primary.with-alpha(0.18)) :
        touch.has-hover ?
            (root.variant == "filled" ? Theme.primary.darker(0.08) :
             root.variant == "tonal" ? Theme.secondary-container.darker(0.08) :
             Theme.primary.with-alpha(0.08)) :
        (root.variant == "filled" ? Theme.primary :
         root.variant == "tonal" ? Theme.secondary-container :
         Colors.transparent);

    // Cero bordes en filled y tonal; 1px solo en outlined
    border-width: root.variant == "outlined" ? 1px : 0px;
    border-color: !root.enabled ? Theme.outline.with-alpha(0.2) :
                  touch.has-hover ? Theme.primary :
                  Theme.outline-variant;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: root.btn-padding-h;
        padding-right: root.btn-padding-h;
        spacing: 8px;
        alignment: center;

        if root.icon-name != "": M3Icon {
            name: root.icon-name;
            icon-size: 18px;
            icon-color: !root.enabled ? Theme.on-surface.with-alpha(0.38) :
                        root.variant == "filled" ? Theme.on-primary :
                        root.variant == "tonal" ? Theme.on-secondary-container :
                        Theme.primary;
            y: (parent.height - self.height) / 2;
        }

        if root.icon-name == "" && root.icon-text != "": Text {
            text: root.icon-text;
            font-size: 15px;
            vertical-alignment: center;
            color: !root.enabled ? Theme.on-surface.with-alpha(0.38) :
                   root.variant == "filled" ? Theme.on-primary :
                   root.variant == "tonal" ? Theme.on-secondary-container :
                   Theme.primary;
        }

        Text {
            text: root.text;
            font-size: Theme.font-label-large;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
            color: !root.enabled ? Theme.on-surface.with-alpha(0.38) :
                   root.variant == "filled" ? Theme.on-primary :
                   root.variant == "tonal" ? Theme.on-secondary-container :
                   Theme.primary;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Botones específicos auxiliares
export component M3FilledButton inherits M3Button {
    variant: "filled";
}

export component M3TonalButton inherits M3Button {
    variant: "tonal";
}

export component M3OutlinedButton inherits M3Button {
    variant: "outlined";
}

// =============================================================================
// M3Switch: Toggle M3 Expressive
// =============================================================================
export component M3Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled(bool);

    width: 52px;
    height: 32px;
    border-radius: 16px;

    background: !root.enabled ? Theme.surface-container-highest.with-alpha(0.38) :
                root.checked ? Theme.primary : Theme.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: !root.enabled ? Theme.outline.with-alpha(0.2) : Theme.outline;

    animate background { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 180ms; easing: ease-out; }

    thumb := Rectangle {
        y: (parent.height - self.height) / 2;
        x: root.checked ?
            (parent.width - self.width - 4px) :
            4px;

        width: root.checked ? 24px : 16px;
        height: root.checked ? 24px : 16px;
        border-radius: 12px;

        background: !root.enabled ? Theme.on-surface.with-alpha(0.38) :
                    root.checked ? Theme.on-primary : Theme.outline;

        animate x { duration: 180ms; easing: ease-out; }
        animate width { duration: 150ms; easing: ease-out; }
        animate height { duration: 150ms; easing: ease-out; }
        animate background { duration: 180ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// =============================================================================
// M3StatusChip: Indicador de estado con halo circular y tonal elevation (Cero bordes)
// =============================================================================
export component M3StatusChip inherits Rectangle {
    in-out property <string> text: "Detenido";
    in-out property <string> status: "idle"; // "recording" | "active" | "idle"

    height: 32px;
    border-radius: Theme.radius-full;
    border-width: 0px;

    background: root.status == "recording" ? Theme.error-container :
                root.status == "active" ? Theme.secondary-container :
                Theme.surface-container-high;

    animate background { duration: 200ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        // Halo exterior
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: (parent.height - self.height) / 2;
            background: root.status == "recording" ? Theme.error.with-alpha(0.25) :
                        root.status == "active" ? Theme.primary.with-alpha(0.25) :
                        Colors.transparent;

            // Dot central
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.status == "recording" ? Theme.error :
                            root.status == "active" ? Theme.primary :
                            Theme.outline;
            }
        }

        Text {
            text: root.text;
            font-size: Theme.font-label-medium;
            font-weight: 700;
            vertical-alignment: center;
            color: root.status == "recording" ? Theme.on-error-container :
                   root.status == "active" ? Theme.on-secondary-container :
                   Theme.on-surface-variant;
        }
    }
}

// =============================================================================
// M3ProfileTile / M3RadioCard: Lista estilo Android Settings (Cero bordes)
// Icono a la izquierda, Título+Descripción al centro, Radio Button anclado a la derecha
// =============================================================================
export component M3ProfileTile inherits Rectangle {
    in-out property <string> title: "Perfil";
    in-out property <string> subtitle: "";
    in-out property <string> badge-text: "";
    in-out property <string> warning-text: "";
    in-out property <bool> is-selected: false;
    in-out property <string> icon-name: "bolt";
    in-out property <string> icon-text: "";

    callback clicked();

    border-radius: Theme.radius-lg;
    border-width: 0px;

    background: root.is-selected ?
        Theme.secondary-container :
        touch.has-hover ?
            Theme.surface-container-high :
            Theme.surface-container;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 16px;
            alignment: center;

            // Icono a la izquierda
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: root.is-selected ?
                    Theme.primary.with-alpha(0.2) :
                    Theme.surface-container-highest;
                y: (parent.height - self.height) / 2;

                if root.icon-name != "": M3Icon {
                    name: root.icon-name;
                    icon-size: 20px;
                    icon-color: root.is-selected ? Theme.primary : Theme.on-surface-variant;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if root.icon-name == "" && root.icon-text != "": Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.icon-text;
                    font-size: 16px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Bloque vertical alineado al centro a la izquierda
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.title;
                        font-size: Theme.font-title-small;
                        font-weight: root.is-selected ? 700 : 600;
                        color: root.is-selected ? Theme.on-secondary-container : Theme.on-surface;
                        vertical-alignment: center;
                    }

                    if root.badge-text != "": Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-full;
                        border-width: 0px;
                        background: root.badge-text == "Experimental" ?
                            Theme.error-container :
                            (root.is-selected ? Theme.primary : Theme.surface-container-highest);
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.badge-text;
                                font-size: Theme.font-label-small;
                                font-weight: 700;
                                vertical-alignment: center;
                                color: root.badge-text == "Experimental" ?
                                    Theme.on-error-container :
                                    (root.is-selected ? Theme.on-primary : Theme.on-surface-variant);
                            }
                        }
                    }
                }

                if root.warning-text != "": Rectangle {
                    height: 24px;
                    border-radius: Theme.radius-xs;
                    border-width: 0px;
                    background: Theme.error-container;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: start;

                        M3Icon {
                            name: "warning";
                            icon-size: 14px;
                            icon-color: Theme.on-error-container;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.warning-text;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.on-error-container;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: Theme.font-body-small;
                    color: root.is-selected ?
                        Theme.on-secondary-container.with-alpha(0.85) :
                        Theme.on-surface-variant;
                }
            }

            // Radio Button anclado completamente a la derecha
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                y: (parent.height - self.height) / 2;
                border-width: 2px;
                border-color: root.is-selected ? Theme.primary : Theme.outline;
                background: Colors.transparent;

                if root.is-selected: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: Theme.primary;
                }
            }
        }
    }
}

export component M3RadioCard inherits M3ProfileTile {}

