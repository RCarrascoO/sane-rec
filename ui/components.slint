// =============================================================================
// M3NavItem: Píldora del Navigation Rail (M3 Expressive)
// =============================================================================
export component M3NavItem inherits Rectangle {
    in-out property <string> icon-name: "dashboard";
    in-out property <string> icon-text: "";
    in-out property <string> text: "Panel";
    in-out property <string> badge-text: "";
    in-out property <bool> is-selected: false;
    in-out property <bool> compact: false;
    callback clicked();

    height: root.compact ? 56px : 48px;
    border-radius: Theme.radius-full;
    border-width: 0px;

    background: root.is-selected ?
        Theme.secondary-container :
        touch.has-hover ?
            Theme.surface-container-high :
            Colors.transparent;

    animate background { duration: 160ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        if !root.compact: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;

            if root.icon-name != "": M3Icon {
                name: root.icon-name;
                icon-size: 20px;
                icon-color: root.is-selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                y: (parent.height - self.height) / 2;
            }

            if root.icon-name == "" && root.icon-text != "": Text {
                text: root.icon-text;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.text;
                font-size: Theme.font-label-large;
                font-weight: root.is-selected ? 700 : 500;
                vertical-alignment: center;
                overflow: elide;
                color: root.is-selected ?
                    Theme.on-secondary-container :
                    Theme.on-surface-variant;
            }

            if root.badge-text != "": Rectangle {
                height: 20px;
                border-radius: Theme.radius-full;
                border-width: 0px;
                background: root.is-selected ? Theme.primary : Theme.surface-container-highest;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: root.badge-text;
                        font-size: Theme.font-label-small;
                        font-weight: 700;
                        color: root.is-selected ? Theme.on-primary : Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.compact: VerticalLayout {
            alignment: center;
            spacing: 3px;
            padding-top: 4px;
            padding-bottom: 4px;

            if root.icon-name != "": M3Icon {
                name: root.icon-name;
                icon-size: 22px;
                icon-color: root.is-selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                x: (parent.width - self.width) / 2;
            }

            if root.icon-name == "" && root.icon-text != "": Text {
                text: root.icon-text;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                font-size: 10px;
                font-weight: root.is-selected ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                color: root.is-selected ?
                    Theme.on-secondary-container :
                    Theme.on-surface-variant;
            }
        }
    }
}

// =============================================================================
// M3NavigationRail: Navigation Rail Vertical M3 Expressive
// Sin bordes con el contenido, cabecera con sane-rec.png, píldoras tonales
// =============================================================================
export component M3NavigationRail inherits Rectangle {
    in-out property <int> active-view: 0;
    in-out property <bool> compact: false;
    in-out property <string> backend-title: "Wayland / niri";
    in-out property <string> backend-subtitle: "PipeWire • 60 FPS";
    callback view-selected(int);

    width: root.compact ? 68px : 188px;
    background: Theme.surface;
    border-width: 0px;
    clip: true;

    animate width { duration: 160ms; easing: ease-out; }

    VerticalLayout {
        padding-left: root.compact ? 6px : 12px;
        padding-right: root.compact ? 6px : 12px;
        padding-top: 18px;
        padding-bottom: 16px;
        spacing: 16px;

        // Logo e Identidad Visual M3 Expressive
        if !root.compact: HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: Theme.surface-container-high;
                border-width: 0px;
                clip: true;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../assets/sane-rec.png");
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "sane-rec";
                    font-size: Theme.font-title-medium;
                    font-weight: 800;
                    color: Theme.on-surface;
                }

                Text {
                    text: "M3 Expressive";
                    font-size: Theme.font-label-small;
                    color: Theme.on-surface-variant;
                }
            }
        }

        if root.compact: Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: Theme.surface-container-high;
            border-width: 0px;
            clip: true;
            x: (parent.width - self.width) / 2;

            Image {
                source: @image-url("../assets/sane-rec.png");
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }

        // Elementos de Navegación (Píldoras M3)
        VerticalLayout {
            spacing: 6px;

            M3NavItem {
                compact: root.compact;
                icon-name: "dashboard";
                text: "Panel";
                is-selected: root.active-view == 0;
                clicked => {
                    root.active-view = 0;
                    root.view-selected(0);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-name: "monitor";
                text: "Fuentes";
                is-selected: root.active-view == 1;
                clicked => {
                    root.active-view = 1;
                    root.view-selected(1);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-name: "mic";
                text: "Audio";
                is-selected: root.active-view == 2;
                clicked => {
                    root.active-view = 2;
                    root.view-selected(2);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-name: "settings";
                text: "Ajustes";
                is-selected: root.active-view == 3;
                clicked => {
                    root.active-view = 3;
                    root.view-selected(3);
                }
            }

            M3NavItem {
                compact: root.compact;
                icon-name: "folder";
                text: "Galería";
                is-selected: root.active-view == 4;
                clicked => {
                    root.active-view = 4;
                    root.view-selected(4);
                }
            }
        }

        // Espaciador expansible
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer informativo tonal sin bordes
        if !root.compact: Rectangle {
            height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.surface-container-low;
            border-width: 0px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.success;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.backend-title;
                        font-size: Theme.font-label-small;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }

                    Text {
                        text: root.backend-subtitle;
                        font-size: 10px;
                        color: Theme.on-surface-variant;
                    }
                }
            }
        }

        if root.compact: Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Theme.surface-container-low;
            border-width: 0px;
            x: (parent.width - self.width) / 2;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.success;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// =============================================================================
// M3MetricTile: Métrica visual M3 con Cero Bordes y Tonal Elevation
// =============================================================================
export component M3MetricTile inherits Rectangle {
    in-out property <string> icon-name: "bolt";
    in-out property <string> icon-text: "";
    in-out property <string> value: "60 FPS";
    in-out property <string> label: "Tasa de refresco";
